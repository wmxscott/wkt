#!/usr/bin/env zsh
# wkt: git worktrees in a .bare layout, opened as Herdr workspaces inside Herdr.
# https://github.com/wmxscott/wkt

emulate -R zsh
setopt err_exit pipe_fail

VERSION=1.0.0
PROG=${0:t}

typeset -g OUT_GREEN= OUT_BLUE= OUT_YELLOW= OUT_RESET=
typeset -g ERR_RED= ERR_YELLOW= ERR_RESET=
if [[ -z ${NO_COLOR-} ]]; then
    if [[ -t 1 ]]; then
        OUT_GREEN=$'\e[32m' OUT_BLUE=$'\e[34m' OUT_YELLOW=$'\e[33m' OUT_RESET=$'\e[0m'
    fi
    if [[ -t 2 ]]; then
        ERR_RED=$'\e[31m' ERR_YELLOW=$'\e[33m' ERR_RESET=$'\e[0m'
    fi
fi

step() { print -r -- "${OUT_YELLOW}→${OUT_RESET} $*"; }
warn() { print -ru2 -- "${ERR_YELLOW}warning:${ERR_RESET} $*"; }

# die <message> [<hint>...]: runtime failure, exit 1.
die() {
    print -ru2 -- "${ERR_RED}error:${ERR_RESET} $1"
    shift
    local line
    for line in "$@"; do print -ru2 -- "  $line"; done
    exit 1
}

# usage_error <command> <message>: bad arguments, exit 2.
usage_error() {
    local cmd=$1
    print -ru2 -- "${ERR_RED}error:${ERR_RESET} $2"
    print -ru2 -- "Run '$PROG${cmd:+ $cmd} --help' for usage."
    exit 2
}

usage() {
    cat <<EOF
Usage: $PROG <command> [options]

Git worktrees in a .bare layout. Inside Herdr, new and renamed worktrees
open as Herdr workspaces.

Commands:
  setup <repo-url>                Clone <repo-url> into a .bare worktree layout
                                  in the current (empty) directory
  adopt                           Turn the current clone into a .bare worktree
                                  layout in place
  new -b <branch> [-s <source>] [-n <label>] [--no-herdr]
                                  Create or reopen the worktree for <branch>
                                  and open it in Herdr
  rename -b <new-branch> [-n <label>] [-y] [--no-herdr]
                                  Rename the current worktree's branch,
                                  directory and Herdr workspace

Options:
  -h, --help                      Show this help, or '$PROG <command> --help'
  -V, --version                   Show the version

Environment:
  WKT_ROOT                        Where worktrees of normal (non-.bare) repos
                                  go (default: ~/.herdr/worktrees)
  NO_COLOR                        Disable coloured output
EOF
}

usage_setup() {
    cat <<EOF
Usage: $PROG setup <repo-url>

Clone <repo-url> as a bare repository into ./.bare, point ./.git at it, and
add a worktree for the default branch. The current directory must be empty.
EOF
}

usage_adopt() {
    cat <<EOF
Usage: $PROG adopt

Turn the normal clone you're in into a .bare layout, in place: .git becomes
.bare, ./.git points at it, and the working tree moves into a worktree named
after the current branch. Uncommitted, staged, untracked and ignored files
move with it. Run it from the top of the clone.
EOF
}

usage_new() {
    cat <<EOF
Usage: $PROG new -b <branch> [-s <source>] [-n <label>] [--no-herdr]

Create the worktree for <branch>, or reuse it if it exists, and open it in
Herdr when run inside Herdr. A new branch is created from <source> unless it
already exists locally or on origin.

Options:
  -b <branch>   Branch to create or open; also the worktree directory name
  -s <source>   Branch to start a new branch from (default: the repo's
                default branch)
  -n <label>    Herdr workspace label (default: chosen by Herdr)
  --no-herdr    Don't open the worktree in Herdr
  -h, --help    Show this help
EOF
}

usage_rename() {
    cat <<EOF
Usage: $PROG rename -b <new-branch> [-n <label>] [-y] [--no-herdr]

Rename the current worktree's branch and directory, rename the branch on
origin if it was pushed, and, inside Herdr, point the Herdr workspace at the
new path. Run it from inside a linked worktree.

Options:
  -b <new-branch>  New branch name; also the new directory name
  -n <label>       Herdr workspace label (default: the new branch name)
  -y               Don't ask before renaming a remote branch that has an
                   open pull request
  --no-herdr       Leave the Herdr workspace alone
  -h, --help       Show this help
EOF
}

# wants_help <args...>: true if --help appears among the arguments.
wants_help() {
    local arg
    for arg in "$@"; do
        [[ $arg == --help ]] && return 0
    done
    return 1
}

# take_no_herdr <args...>: set NO_HERDR if --no-herdr is among the arguments
# and leave the rest in ARGS.
typeset -g NO_HERDR=0
typeset -ga ARGS
take_no_herdr() {
    ARGS=()
    local arg
    for arg in "$@"; do
        if [[ $arg == --no-herdr ]]; then
            NO_HERDR=1
        else
            ARGS+=("$arg")
        fi
    done
}

# Print $1 relative to $2 (both resolved to absolute paths first).
relpath() {
    local -a target base
    target=("${(s:/:)${1:A}}")
    base=("${(s:/:)${2:A}}")

    local i=1
    while [[ $i -le ${#target} && $i -le ${#base} && "${target[i]}" == "${base[i]}" ]]; do
        (( i++ ))
    done

    local rel="" n=$(( ${#base} - i + 1 ))
    for (( ; n > 0; n-- )); do rel+="../"; done
    for (( ; i <= ${#target}; i++ )); do rel+="${target[i]}/"; done

    rel="${rel%/}"
    print -r -- "${rel:-.}"
}

# Replace a leading $HOME with ~ for display.
tildify() {
    if [[ $1 == $HOME || $1 == $HOME/* ]]; then
        print -r -- "~${1#$HOME}"
    else
        print -r -- "$1"
    fi
}

# The repo's shared git directory as an absolute path with symlinks resolved,
# the same from the main checkout, a linked worktree or a .bare layout root.
common_git_dir() {
    local dir
    dir=$(git rev-parse --git-common-dir)
    print -r -- "${dir:A}"
}

# The repo's default branch: origin's HEAD, else a bare repo's own HEAD,
# else main or master, whichever exists.
detect_default_branch() {
    local ref
    ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    if [[ -n "$ref" ]]; then
        print -r -- "${ref#origin/}"
        return
    fi
    if [[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == true ]] ||
        [[ "$(git --git-dir="$(common_git_dir)" config --bool core.bare 2>/dev/null)" == true ]]; then
        ref=$(git --git-dir="$(common_git_dir)" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
        if [[ -n "$ref" ]] && git show-ref --verify --quiet "refs/heads/$ref"; then
            print -r -- "$ref"
            return
        fi
    fi
    if git show-ref --verify --quiet refs/remotes/origin/main || git show-ref --verify --quiet refs/heads/main; then
        print -r -- "main"
    elif git show-ref --verify --quiet refs/remotes/origin/master || git show-ref --verify --quiet refs/heads/master; then
        print -r -- "master"
    else
        print -r -- "main"
    fi
}

# Print the path of the worktree that has branch $1 checked out, if any.
worktree_for_branch() {
    local line wt=""
    for line in "${(@f)$(git worktree list --porcelain)}"; do
        case $line in
            "worktree "*) wt=${line#worktree } ;;
            "branch refs/heads/$1") print -r -- "$wt"; return 0 ;;
        esac
    done
    return 1
}

# True if $1 is a registered worktree of this repo.
is_worktree() {
    local line want=${1:A}
    for line in "${(@f)$(git worktree list --porcelain)}"; do
        [[ $line == "worktree "* && ${${line#worktree }:A} == $want ]] && return 0
    done
    return 1
}

# The root that worktrees of normal repos live under.
worktree_root() {
    local root=${WKT_ROOT:-$HOME/.herdr/worktrees}
    root=${root/#\~/$HOME}
    [[ $root == /* ]] || die "WKT_ROOT must be an absolute path, not '$WKT_ROOT'."
    print -r -- "${root%/}"
}

# herdr_open <repo-git-dir> <worktree-path> [<label>]
# Open the worktree as a Herdr workspace, only when running inside Herdr and
# not told --no-herdr. The git work is already done, so a missing or
# unreachable Herdr only warns; the status says whether it opened.
herdr_open() {
    (( ! NO_HERDR )) && [[ -n ${HERDR_TAB_ID-} ]] || return 1

    local repo_dir=$1 wt_path=$2 label=${3-}
    local -a args=(worktree open --cwd "$repo_dir" --path "$wt_path")
    [[ -n "$label" ]] && args+=(--label "$label")
    args+=(--focus)

    if ! command -v herdr >/dev/null 2>&1; then
        warn "herdr not found on PATH; skipped opening the worktree in Herdr."
        return 1
    fi
    local err
    if ! err=$(herdr "${args[@]}" 2>&1 >/dev/null); then
        local -a err_lines=("${(@f)err}")
        warn "Herdr didn't open the worktree${err:+: ${err_lines[1]}}"
        print -ru2 -- "  Is Herdr running? To open it by hand: herdr ${(j: :)${(@q-)args}}"
        return 1
    fi
    return 0
}

cmd_setup() {
    wants_help "$@" && { usage_setup; exit 0; }
    [[ $# -eq 0 ]] && usage_error setup "Repo URL is required."
    [[ $1 == -* ]] && usage_error setup "Unknown option: $1"
    [[ $# -gt 1 ]] && usage_error setup "Unexpected argument: $2"
    local repo_url=$1

    if [[ -n "$(ls -A . 2>/dev/null)" ]]; then
        die "Current directory is not empty." "Run '$PROG setup' in a new, empty directory."
    fi

    step "cloning $repo_url into .bare"
    git clone --bare "$repo_url" .bare
    print -r -- "gitdir: ./.bare" > .git
    git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"

    step "fetching origin"
    git fetch origin
    git remote set-head origin --auto >/dev/null 2>&1 || true

    local default_branch
    default_branch=$(detect_default_branch)

    step "adding worktree for $default_branch"
    git worktree add "$default_branch" "$default_branch"
    if git show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
        git branch --quiet --set-upstream-to="origin/$default_branch" "$default_branch" 2>/dev/null || true
    fi

    print -r -- "${OUT_GREEN}✓${OUT_RESET} .bare worktree layout ready  ${OUT_BLUE}${default_branch}${OUT_RESET}"
}

cmd_adopt() {
    wants_help "$@" && { usage_adopt; exit 0; }
    if [[ $# -gt 0 ]]; then
        [[ $1 == -* ]] && usage_error adopt "Unknown option: $1"
        usage_error adopt "Unexpected argument: $1"
    fi

    git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a Git worktree."
    [[ ${$(common_git_dir):t} != .bare ]] || die "This is already a .bare layout."
    [[ "$(git rev-parse --is-inside-work-tree)" == true ]] || die "Not inside a Git worktree."

    local root
    root=$(git rev-parse --show-toplevel)
    root=${root:A}
    [[ ${PWD:A} == $root ]] ||
        die "Run '$PROG adopt' from the top of the clone." "That's $(tildify "$root")."
    [[ -d .git ]] ||
        die "'.git' isn't a folder, so this is a linked worktree or a submodule." \
            "Run '$PROG adopt' in the repository's main checkout."
    [[ ! -e .bare ]] || die "'.bare' already exists."
    [[ ! -e .gitmodules && ! -e .git/modules ]] ||
        die "Repositories with submodules aren't supported."

    local branch
    branch=$(git branch --show-current)
    [[ -n $branch ]] ||
        die "Detached HEAD." "Check out a branch first; the worktree is named after it."
    git rev-parse --verify --quiet HEAD >/dev/null || die "'$branch' has no commits yet."

    local state
    for state in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG rebase-merge rebase-apply sequencer; do
        [[ ! -e .git/$state ]] ||
            die "A merge, rebase, cherry-pick, revert or bisect is in progress." \
                "Finish or abort it, then try again."
    done

    # Stage the working tree in a hidden folder first, so a top-level entry
    # sharing the branch's name can't get in the way of the worktree path.
    local stage="$root/.wkt-adopt.$$" wt_path="$root/$branch"
    local files_at=$root repo_at="$root/.git"
    trap 'print -ru2 -- "  adopt stopped partway; nothing was deleted. Your files are in $(tildify "$files_at"), the repository in $(tildify "$repo_at")."' ZERR

    local -a entries=( *(DN) ) linked=() line
    entries=( ${entries:#.git} )
    for line in "${(@f)$(git worktree list --porcelain)}"; do
        if [[ $line == "worktree "* && ${${line#worktree }:A} != $root ]]; then
            linked+=("${line#worktree }")
        fi
    done

    step "moving the working tree aside"
    mkdir "$stage"
    files_at=$stage
    if (( ${#entries} )); then
        mv -- "${entries[@]}" "$stage/"
    fi

    step "moving .git to .bare"
    mv .git .bare
    repo_at="$root/.bare"
    print -r -- "gitdir: ./.bare" > .git
    git config core.bare true

    step "adding worktree for $branch"
    git worktree add --quiet --no-checkout "$branch" "$branch"
    mv "$wt_path/.git" "$stage/.git"
    rmdir "$wt_path"
    mv "$stage" "$wt_path"
    files_at=$wt_path

    # The old index carries what was staged; a fresh one would unstage it.
    local wt_git_dir
    wt_git_dir=$(git -C "$wt_path" rev-parse --absolute-git-dir)
    if [[ -f .bare/index ]]; then
        mv .bare/index "$wt_git_dir/index"
    else
        git -C "$wt_path" reset --quiet
    fi
    git -C "$wt_path" update-index -q --refresh >/dev/null 2>&1 || true

    # Linked worktrees made before still point at .git. Repair also rewrites
    # ./.git with an absolute path, so put the relative one back.
    if (( ${#linked} )); then
        git worktree repair "${linked[@]}" >/dev/null 2>&1 || true
        print -r -- "gitdir: ./.bare" > .git
    fi
    trap - ZERR

    print -r -- "${OUT_GREEN}✓${OUT_RESET} .bare worktree layout ready  ${OUT_BLUE}${branch}${OUT_RESET}"
    print -r -- "${OUT_YELLOW}→${OUT_RESET} your files moved into ./$branch; run: cd ${(q-)branch}"
    print -r -- "${OUT_YELLOW}→${OUT_RESET} editors and tools that remember absolute paths (direnv, mise trust) need the new folder"
}

cmd_new() {
    wants_help "$@" && { usage_new; exit 0; }
    take_no_herdr "$@"
    set -- "${ARGS[@]}"
    local new_branch="" source_branch="" label="" opt
    local OPTIND=1 OPTARG
    while getopts ":b:s:n:h" opt; do
        case $opt in
            b ) new_branch=$OPTARG ;;
            s ) source_branch=$OPTARG ;;
            n ) label=$OPTARG ;;
            h ) usage_new; exit 0 ;;
            : ) usage_error new "Option -$OPTARG needs a value." ;;
            * ) usage_error new "Unknown option: -$OPTARG" ;;
        esac
    done
    shift $(( OPTIND - 1 ))
    [[ $# -gt 0 ]] && usage_error new "Unexpected argument: $1"
    [[ -z "$new_branch" ]] && usage_error new "Branch name (-b) is required."

    git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a Git repository."
    git check-ref-format --branch "$new_branch" >/dev/null 2>&1 ||
        die "'$new_branch' is not a valid branch name."

    local common_dir target_path is_bare
    common_dir=$(common_git_dir)

    if [[ ${common_dir:t} == .bare ]]; then
        # .bare layout: worktrees live next to .bare/.
        is_bare=1
        target_path="${common_dir:h}/${new_branch}"
    else
        # Normal repo: keep worktrees out of the checkout, under
        # <root>/<org>/<repo>/<branch>, named from origin's URL.
        is_bare=0
        local remote_url path_part org repo
        remote_url=$(git config --get remote.origin.url 2>/dev/null || true)
        if [[ -n "$remote_url" ]]; then
            path_part="${remote_url#*://}"
            path_part="${path_part#*@}"
            path_part="${path_part/://}"
            path_part="${${path_part%/}%.git}"
            org=${path_part:h:t}
            repo=${path_part:t}
        else
            org="local"
            if [[ ${common_dir:t} == .git ]]; then
                repo=${common_dir:h:t}
            else
                repo=${${common_dir:t}%.git}
            fi
        fi
        local root
        root=$(worktree_root)
        target_path="${root}/${org}/${repo}/${new_branch}"
    fi

    local existing
    existing=$(worktree_for_branch "$new_branch" || true)

    if [[ -n "$existing" ]]; then
        target_path=$existing
    elif [[ -d "$target_path" ]]; then
        if ! is_worktree "$target_path"; then
            git worktree repair "$target_path" >/dev/null 2>&1 || true
            is_worktree "$target_path" ||
                die "'$target_path' exists and isn't a worktree of this repo." \
                    "Move or remove it, then try again."
        fi
    elif git show-ref --verify --quiet "refs/heads/$new_branch"; then
        git worktree add "$target_path" "$new_branch" >/dev/null
    elif git show-ref --verify --quiet "refs/remotes/origin/$new_branch"; then
        git worktree add --track -b "$new_branch" "$target_path" "origin/$new_branch" >/dev/null
    else
        [[ -z "$source_branch" ]] && source_branch=$(detect_default_branch)

        if git remote get-url origin >/dev/null 2>&1; then
            step "updating $source_branch from origin"
            git fetch origin "$source_branch" >/dev/null 2>&1 || true
        fi

        local base_ref
        if git show-ref --verify --quiet "refs/remotes/origin/$source_branch"; then
            base_ref="origin/$source_branch"
        elif git rev-parse --verify --quiet "${source_branch}^{commit}" >/dev/null; then
            base_ref=$source_branch
        else
            die "Source branch '$source_branch' not found locally or on origin."
        fi

        step "branching from $base_ref"
        git worktree add --no-track -b "$new_branch" "$target_path" "$base_ref" >/dev/null
    fi

    local herdr_note=""
    if herdr_open "$common_dir" "$target_path" "$label"; then
        herdr_note="  ${OUT_BLUE}opened in Herdr${OUT_RESET}"
    fi

    local display_path
    if [[ $is_bare -eq 1 ]]; then
        display_path=$(relpath "$target_path" "$PWD")
    else
        display_path=$(tildify "$target_path")
    fi

    print -r -- "${OUT_GREEN}✓${OUT_RESET} ${new_branch}${label:+ ($label)}  ${display_path}${herdr_note}"
}

cmd_rename() {
    wants_help "$@" && { usage_rename; exit 0; }
    take_no_herdr "$@"
    set -- "${ARGS[@]}"
    local new_branch="" new_label="" auto_yes=0 opt
    local OPTIND=1 OPTARG
    while getopts ":b:n:yh" opt; do
        case $opt in
            b ) new_branch=$OPTARG ;;
            n ) new_label=$OPTARG ;;
            y ) auto_yes=1 ;;
            h ) usage_rename; exit 0 ;;
            : ) usage_error rename "Option -$OPTARG needs a value." ;;
            * ) usage_error rename "Unknown option: -$OPTARG" ;;
        esac
    done
    shift $(( OPTIND - 1 ))
    [[ $# -gt 0 ]] && usage_error rename "Unexpected argument: $1"
    [[ -z "$new_branch" ]] && usage_error rename "New branch name (-b) is required."

    [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" == true ]] ||
        die "Not inside a Git worktree."

    local git_dir common_dir
    git_dir=$(git rev-parse --absolute-git-dir)
    git_dir=${git_dir:A}
    common_dir=$(common_git_dir)

    if [[ "$git_dir" == "$common_dir" ]]; then
        die "Refusing to rename the main checkout." \
            "Run this from inside a linked worktree created by '$PROG new'."
    fi

    local old_branch
    old_branch=$(git branch --show-current)
    [[ -n "$old_branch" ]] || die "Detached HEAD; nothing to rename."
    [[ "$new_branch" != "$old_branch" ]] || die "'$new_branch' is already the current branch name."
    git check-ref-format --branch "$new_branch" >/dev/null 2>&1 ||
        die "'$new_branch' is not a valid branch name."
    ! git show-ref --verify --quiet "refs/heads/$new_branch" ||
        die "Branch '$new_branch' already exists."

    # The worktree directory is named after the branch, which may contain
    # slashes, so swap the branch suffix rather than just the last component.
    local old_path new_path base
    old_path=$(git rev-parse --show-toplevel)
    old_path=${old_path:A}
    if [[ $old_path == */$old_branch ]]; then
        base=${old_path%/$old_branch}
    else
        base=${old_path:h}
    fi
    new_path="${base}/${new_branch}"

    [[ ! -e "$new_path" ]] || die "'$new_path' already exists."

    local remote_url has_remote_branch=0
    remote_url=$(git config --get remote.origin.url 2>/dev/null || true)
    if [[ -n "$remote_url" ]] && git show-ref --verify --quiet "refs/remotes/origin/$old_branch"; then
        has_remote_branch=1
    fi

    if [[ $has_remote_branch -eq 1 ]]; then
        local pr_line="" pr_number="" pr_state="" pr_url="" pr_open=0
        if command -v gh >/dev/null 2>&1; then
            pr_line=$(gh pr view "$old_branch" --json number,state,url --jq '[.number,.state,.url]|@tsv' 2>/dev/null || true)
            if [[ -n "$pr_line" ]]; then
                IFS=$'\t' read -r pr_number pr_state pr_url <<< "$pr_line"
                [[ "$pr_state" == "OPEN" ]] && pr_open=1
            fi
        fi

        # Neither GitHub's branch-rename API nor push+delete keeps an open PR
        # attached to the renamed branch; GitHub closes it. Only the rename
        # button in GitHub's web UI migrates an open PR.
        if [[ $pr_open -eq 1 && $auto_yes -eq 0 ]]; then
            warn "PR #$pr_number is open for '$old_branch' ($pr_url)."
            print -ru2 -- "  Renaming the remote branch will close that PR: GitHub doesn't carry an open"
            print -ru2 -- "  PR across a branch rename done with git or gh, so you'd need a new PR."
            print -ru2 -- "  To keep the PR, rename the branch in GitHub's web UI instead, then run"
            print -ru2 -- "  '$PROG rename' here to bring the local branch, directory and Herdr workspace in line."
            print -ru2 -- "  Pass -y to rename anyway and close the PR."
            [[ -t 0 ]] || die "No terminal to confirm; pass -y to proceed. Nothing was changed."
            printf "  Continue anyway? [y/N] " >&2
            local reply=""
            read -r reply || true
            [[ "$reply" == [yY]* ]] || die "Aborted. Nothing was changed."
        fi

        local renamed_remote=0 gh_err=""
        if [[ "$remote_url" == *github.com* ]] && command -v gh >/dev/null 2>&1; then
            if gh_err=$(gh api --method POST "repos/{owner}/{repo}/branches/${old_branch}/rename" -f new_name="$new_branch" 2>&1); then
                renamed_remote=1
                step "renamed remote branch with the GitHub API"
            else
                warn "GitHub's branch-rename API failed, falling back to push and delete:"
                print -ru2 -- "  $gh_err"
            fi
        fi

        if [[ $renamed_remote -eq 0 ]]; then
            step "pushing '$new_branch' to origin"
            git push origin "refs/heads/${old_branch}:refs/heads/${new_branch}"
            step "deleting '$old_branch' from origin"
            git push origin --delete "$old_branch"
        fi

        step "syncing remote-tracking branches"
        git fetch --prune origin >/dev/null 2>&1 || true
    fi

    git branch -m "$old_branch" "$new_branch"

    if [[ $has_remote_branch -eq 1 ]]; then
        git branch --quiet --set-upstream-to="origin/$new_branch" "$new_branch" 2>/dev/null || true
    fi

    mkdir -p "${new_path:h}"
    git -C "$common_dir" worktree move "$old_path" "$new_path"

    # Drop directories left empty by a branch name with slashes.
    local dir=${old_path:h}
    while [[ $dir == $base/* ]] && rmdir "$dir" 2>/dev/null; do
        dir=${dir:h}
    done

    local herdr_note=""
    if herdr_open "$common_dir" "$new_path" "${new_label:-$new_branch}"; then
        herdr_note="  ${OUT_BLUE}Herdr workspace updated${OUT_RESET}"
    fi

    print -r -- "${OUT_GREEN}✓${OUT_RESET} ${old_branch} → ${new_branch}  $(tildify "$new_path")${herdr_note}"
    print -r -- "${OUT_YELLOW}→${OUT_RESET} your shell is still in the old directory; run: cd ${(q-)new_path}"
}

# ui_theme: pick light or dark (WKT_THEME, then theme-monitor's trigger file,
# then macOS) into UI_THEME, and fill PAL and the glyphs to match.
typeset -gA PAL
typeset -g UI_THEME=light
ui_theme() {
    # The glyphs need a UTF-8 locale to be written as escapes.
    [[ ${LC_ALL:-${LC_CTYPE:-${LANG-}}} == *(UTF-8|utf-8|UTF8|utf8)* ]] || export LC_ALL=en_US.UTF-8

    local theme=${(L)${WKT_THEME-}}
    if [[ $theme != (light|dark) ]]; then
        local data=${XDG_DATA_HOME-} file
        [[ $data == /* ]] || data=$HOME/.local/share
        file=$data/theme-monitor/theme-change.trigger
        theme=""
        if [[ -r $file ]]; then
            theme=${"$(<$file)"//[[:space:]]/}
        fi
        if [[ $theme != (light|dark) ]]; then
            theme=light
            if [[ $OSTYPE == darwin* ]] && command -v defaults >/dev/null 2>&1; then
                local style
                style=$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)
                [[ $style != Dark ]] || theme=dark
            fi
        fi
    fi
    UI_THEME=$theme

    # Catppuccin Macchiato and Latte, as in herdr-projects' theme.py.
    if [[ $theme == dark ]]; then
        PAL=(
            base '36;39;58'       surface0 '54;58;79'    surface1 '73;77;100'
            surface2 '91;96;120'  overlay0 '110;115;141' overlay1 '128;135;162'
            subtext0 '165;173;203' text '202;211;245'
            green '166;218;149'   red '237;135;150'      yellow '238;212;159'
            peach '245;169;127'   mauve '198;160;246'    blue '138;173;244'
        )
    else
        PAL=(
            base '239;241;245'    surface0 '204;208;218' surface1 '188;192;204'
            surface2 '172;176;190' overlay0 '156;160;176' overlay1 '140;143;161'
            subtext0 '108;111;133' text '76;79;105'
            green '64;160;43'     red '210;15;57'        yellow '223;142;29'
            peach '254;100;11'    mauve '136;57;239'     blue '30;102;245'
        )
    fi

    typeset -g UI_ICO_BRANCH=$''     # nf-oct-git_branch
    typeset -g UI_ICO_HOME=$''       # nf-oct-home
    typeset -g UI_ICO_COMMIT=$''     # nf-oct-git_commit
    typeset -g UI_ICO_CURRENT=$''    # nf-fa-circle
    typeset -g UI_ICO_OPEN=$''       # nf-oct-circle
    typeset -g UI_ICO_MISSING=$'\U000f0338' # nf-md-link_off
    typeset -g UI_ICO_LOCKED=$''     # nf-oct-lock
    typeset -g UI_ICO_ALERT=$''      # nf-oct-alert
    typeset -g UI_ENTER=$'↵' UI_ELLIPSIS=$'…'
}

# ui_paint <colour> [bold|dim] <text>: the text in a PAL colour, in REPLY.
ui_paint() {
    local colour=$1 attr=""
    shift
    if (( $# > 1 )); then
        case $1 in
            bold ) attr="1;" ;;
            dim ) attr="2;" ;;
        esac
        shift
    fi
    if [[ -n ${NO_COLOR-} ]]; then
        REPLY=$1
    else
        REPLY=$'\e['"${attr}38;2;${PAL[$colour]}m$1"$'\e[0m'
    fi
}

# ui_header <hints> [<title>] [<notice>]: fzf's three header rows, in REPLY.
# The notice comes painted.
ui_header() {
    local hints=$1 title=${2-} notice=${3-} line
    if [[ -n $title ]]; then
        ui_paint overlay0 dim " · $hints"
        line=$REPLY
        ui_paint text bold "$title"
        line=$REPLY$line
    else
        ui_paint overlay0 dim "$hints"
        line=$REPLY
    fi
    REPLY=" "$'\n'"$line"$'\n'"${notice:- }"
}

# ui_clip <cells> <text> [left]: the text cut to fit, an ellipsis marking the
# cut at its end, or its start with 'left'. In REPLY.
ui_clip() {
    local -i cells=$1
    local text=$2
    if (( ${(m)#text} <= cells )); then
        REPLY=$text
    elif (( cells < 1 )); then
        REPLY=""
    elif [[ ${3-} == left ]]; then
        (( ${#text} <= cells )) || text=${text[-cells,-1]}
        while (( ${(m)#text} > cells - 1 )); do text=${text[2,-1]}; done
        REPLY=$UI_ELLIPSIS$text
    else
        (( ${#text} <= cells )) || text=${text[1,cells]}
        while (( ${(m)#text} > cells - 1 )); do text=${text[1,-2]}; done
        REPLY=$text$UI_ELLIPSIS
    fi
}

# ui_width: the cells a list row may take, in REPLY: the terminal less the
# preview's 40% and fzf's pointer, marker and scrollbar columns.
ui_width() {
    local size cols
    size=$({ stty size </dev/tty } 2>/dev/null || true)
    cols=${${(z)size}[2]-}
    [[ $cols == <-> ]] || cols=${COLUMNS-}
    [[ $cols == <-> ]] && (( cols > 0 )) || cols=80
    REPLY=$(( cols * 60 / 100 - 3 ))
    (( REPLY >= 20 )) || REPLY=20
}

# ui_fzf <prompt> <header> [<fzf args>...]: fzf with the picker's shared look.
ui_fzf() {
    local prompt=$1 header=$2
    shift 2
    fzf --ansi --layout=reverse --height=100% --border=none --margin=0 --padding=0 --no-info \
        --prompt "$prompt" --header "$header" "$@" || return
}

# ui_parse <fzf output>: split what fzf printed with --print-query and
# --expect into UI_QUERY, UI_KEY and UI_SEL.
typeset -g UI_QUERY= UI_KEY= UI_SEL=
ui_parse() {
    local -a lines=("${(@f)1}")
    UI_QUERY=${lines[1]-} UI_KEY=${lines[2]-} UI_SEL=${lines[3]-}
}

# ui_rows: fill UI_ROWS with one fzf row per worktree, default branch first,
# and UI_AT with the current worktree's row, or 0. A row is
# head<TAB>branch<TAB>tail<TAB>path; fzf shows a tab as one cell.
typeset -ga UI_ROWS
typeset -gi UI_AT=0
ui_rows() {
    local common_dir default here
    common_dir=$(common_git_dir)
    default=$(detect_default_branch)
    here=$(git rev-parse --show-toplevel 2>/dev/null || true)
    [[ -z $here ]] || here=${here:A}

    local -a e_path e_branch e_head e_flag
    local line wt="" head="" branch="" flag="" bare=0
    for line in "${(@f)$(git worktree list --porcelain)}" ""; do
        case $line in
            "worktree "* ) wt=${line#worktree } ;;
            "HEAD "* ) head=${line#HEAD } ;;
            "branch refs/heads/"* ) branch=${line#branch refs/heads/} ;;
            bare ) bare=1 ;;
            prunable | "prunable "* ) flag=missing ;;
            locked | "locked "* ) [[ $flag == missing ]] || flag=locked ;;
            "" )
                if [[ -n $wt ]] && (( ! bare )); then
                    if [[ -n $branch && $branch == $default ]]; then
                        e_path=("$wt" "${e_path[@]}") e_branch=("$branch" "${e_branch[@]}")
                        e_head=("$head" "${e_head[@]}") e_flag=("$flag" "${e_flag[@]}")
                    else
                        e_path+=("$wt") e_branch+=("$branch") e_head+=("$head") e_flag+=("$flag")
                    fi
                fi
                wt="" head="" branch="" flag="" bare=0 ;;
        esac
    done

    local -a names shown
    local base=${common_dir:h} name i
    for (( i = 1; i <= ${#e_path}; i++ )); do
        wt=${e_path[i]}
        names+=("${e_branch[i]:-${e_head[i][1,7]}}")
        if [[ ${common_dir:t} == .bare && $wt == $base/* ]]; then
            shown+=("${wt#$base/}")
        elif [[ $wt == $HOME || $wt == $HOME/* ]]; then
            shown+=("~${wt#$HOME}")
        else
            shown+=("$wt")
        fi
    done

    # Cells: an icon and a gap, the branch column, a gap, the path, the status.
    local -i width label_end=0 room pad fill
    ui_width
    width=$REPLY
    room=$(( width - 6 ))
    for name in "${names[@]}"; do
        (( ${(m)#name} <= label_end )) || label_end=${(m)#name}
    done
    (( label_end <= room )) || label_end=room

    local icon status_icon label path_text sp=""
    UI_ROWS=() UI_AT=0
    for (( i = 1; i <= ${#e_path}; i++ )); do
        wt=${e_path[i]}
        if [[ -z ${e_branch[i]} ]]; then
            icon=$UI_ICO_COMMIT
        elif [[ ${e_branch[i]} == $default ]]; then
            icon=$UI_ICO_HOME
        else
            icon=$UI_ICO_BRANCH
        fi
        ui_paint overlay1 "$icon"
        icon=$REPLY

        if [[ -n $here && ${wt:A} == $here ]]; then
            UI_AT=$i
            ui_paint green bold "$UI_ICO_CURRENT"
        elif [[ ${e_flag[i]} == missing ]]; then
            ui_paint red "$UI_ICO_MISSING"
        elif [[ ${e_flag[i]} == locked ]]; then
            ui_paint yellow "$UI_ICO_LOCKED"
        else
            REPLY=" "
        fi
        status_icon=$REPLY

        ui_clip $label_end "${names[i]}"
        name=$REPLY
        ui_clip $(( room - label_end - 2 )) "${shown[i]}" left
        path_text=$REPLY
        pad=$(( label_end - ${(m)#name} + 1 ))
        fill=$(( width - label_end - 6 - ${(m)#path_text} ))
        (( fill >= 0 )) || fill=0
        ui_paint text "$name"
        label=$REPLY
        ui_paint overlay0 dim "$path_text"

        UI_ROWS+=("$icon "$'\t'"$label"$'\t'"${(l:pad:)sp}$REPLY${(l:fill:)sp}$status_icon"$'\t'"$wt")
    done
}

cmd_ui() {
    exec 3>&1 1>&2
    git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a Git repository."
    command -v fzf >/dev/null 2>&1 || die "The picker needs fzf: brew install fzf"

    local -a words=(${(z)"$(fzf --version 2>/dev/null || true)"})
    local ver=${words[1]-} major minor
    major=${ver%%.*} minor=${${ver#*.}%%.*}
    [[ $major == <-> && $minor == <-> ]] && (( major > 0 || minor >= 36 )) ||
        die "The picker needs fzf 0.36 or newer; found ${ver:-an unknown version}." "brew upgrade fzf"

    ui_theme
    ui_rows
    local -a args=(--delimiter $'\t' --with-nth 1..3 --nth 2 --tabstop 1 --expect ctrl-n --print-query)
    (( UI_AT > 1 )) && args+=(--bind "load:pos($UI_AT)")

    local out st=0 header
    ui_header "$UI_ENTER open · ^n new · esc quit"
    header=$REPLY
    out=$({ (( ! ${#UI_ROWS} )) || print -rl -- "${UI_ROWS[@]}"; } |
        ui_fzf '> ' "$header" "${args[@]}") || st=$?
    (( st == 130 )) && exit 130
    (( st == 0 || st == 1 )) || die "fzf exited with status $st."
    ui_parse "$out"

    # Task 6 starts a new worktree here, on ctrl-n or when nothing matched.
    [[ $UI_KEY == ctrl-n || -z $UI_SEL ]] && return 0
    print -r -- "${UI_SEL##*$'\t'}" >&3
}

case "${1-}" in
    setup ) shift; cmd_setup "$@" ;;
    adopt ) shift; cmd_adopt "$@" ;;
    new ) shift; cmd_new "$@" ;;
    rename ) shift; cmd_rename "$@" ;;
    -h | --help | help ) usage ;;
    -V | --version ) print -r -- "wkt $VERSION" ;;
    "" )
        if [[ -t 0 && -t 2 || -n ${WKT_ASSUME_TTY-} ]]; then
            cmd_ui
        else
            usage >&2
            exit 2
        fi ;;
    -* ) usage_error "" "Unknown option: $1" ;;
    * ) usage_error "" "Unknown command: $1" ;;
esac

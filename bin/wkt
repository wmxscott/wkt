#!/usr/bin/env zsh
# wkt: git worktrees in a .bare layout, opened as Herdr workspaces on request.
# https://github.com/wmxscott/wkt

emulate -R zsh
setopt err_exit pipe_fail

VERSION=1.1.1
PROG=${0:t}
SELF=${0:A}

typeset -g OUT_GREEN= OUT_BLUE= OUT_YELLOW= OUT_RESET=
typeset -g ERR_RED= ERR_YELLOW= ERR_RESET=
if [[ -z ${NO_COLOR-} ]]; then
    if [[ -t 1 ]]; then
        OUT_GREEN=$'\e[32m' OUT_BLUE=$'\e[34m' OUT_YELLOW=$'\e[33m' OUT_RESET=$'\e[0m'
    fi
    if [[ -t 2 ]]; then
        ERR_RED=$'\e[31m' ERR_YELLOW=$'\e[33m' ERR_RESET=$'\e[0m'
    fi
fi

step() { print -r -- "${OUT_YELLOW}→${OUT_RESET} $*"; }
warn() { print -ru2 -- "${ERR_YELLOW}warning:${ERR_RESET} $*"; }

# die <message> [<hint>...]: runtime failure, exit 1.
die() {
    print -ru2 -- "${ERR_RED}error:${ERR_RESET} $1"
    shift
    local line
    for line in "$@"; do print -ru2 -- "  $line"; done
    exit 1
}

# usage_error <command> <message>: bad arguments, exit 2.
usage_error() {
    local cmd=$1
    print -ru2 -- "${ERR_RED}error:${ERR_RESET} $2"
    print -ru2 -- "Run '$PROG${cmd:+ $cmd} --help' for usage."
    exit 2
}

usage() {
    cat <<EOF
Usage: $PROG <command> [options]

Git worktrees in a .bare layout. With --herdr, a new or picked worktree
opens as a Herdr workspace; with --tmux, new opens it as a tmux session.
rename and rm keep an open workspace or session in step.

Commands:
  (no command) [--herdr]          Pick or create a worktree (needs fzf) and
                                  print its path, or open it in Herdr
  setup <repo-url>                Clone <repo-url> into a .bare worktree layout
                                  in the current (empty) directory
  adopt                           Turn the current clone into a .bare worktree
                                  layout in place
  new -b <branch> [-s <source>] [-n <name>] [--tmux | --herdr]
                                  Create or reopen the worktree for <branch>,
                                  and with --tmux or --herdr open it there
  rename -b <new-branch> [-n <name>] [-y]
                                  Rename the current worktree's branch,
                                  directory, Herdr workspace and tmux
                                  session
  rm [-b <branch>] [-f]           Remove the current worktree, or <branch>'s,
                                  with its Herdr workspace and tmux session,
                                  and its branch if merged
  rm --merged [-y]                Remove every worktree whose branch is
                                  merged, after asking

Options:
  -h, --help                      Show this help, or '$PROG <command> --help'
  -V, --version                   Show the version

Environment:
  WKT_ROOT                        Where worktrees of normal (non-.bare) repos
                                  go (default: ~/.herdr/worktrees)
  WKT_THEME                       Picker colours: light, dark or auto (default)
  NO_COLOR                        Disable coloured output
EOF
}

usage_setup() {
    cat <<EOF
Usage: $PROG setup <repo-url>

Clone <repo-url> as a bare repository into ./.bare, point ./.git at it, and
add a worktree for the default branch. The current directory must be empty.
EOF
}

usage_adopt() {
    cat <<EOF
Usage: $PROG adopt

Turn the normal clone you're in into a .bare layout, in place: .git becomes
.bare, ./.git points at it, and the working tree moves into a worktree named
after the current branch. Uncommitted, staged, untracked and ignored files
move with it. Run it from the top of the clone.
EOF
}

usage_new() {
    cat <<EOF
Usage: $PROG new -b <branch> [-s <source>] [-n <name>] [--tmux | --herdr]

Create the worktree for <branch>, or reuse it if it exists, and print its
path. A new branch is created from <source> unless it already exists locally
or on origin.

Options:
  -b <branch>   Branch to create or open; also the worktree directory name
  -s <source>   Branch to start a new branch from (default: the repo's
                default branch)
  -n <name>     With --tmux, the session name (default: <repo>/<branch>);
                with --herdr, the workspace label (default: chosen by Herdr)
  --tmux        Open the worktree as a tmux session and switch to it, or
                outside tmux, print how to attach to it
  --herdr       Open the worktree as a Herdr workspace and focus it
  -h, --help    Show this help
EOF
}

usage_rename() {
    cat <<EOF
Usage: $PROG rename -b <new-branch> [-n <name>] [-y]

Rename the current worktree's branch and directory, rename the branch on
origin if it was pushed, point the worktree's Herdr workspace, if it has
one, at the new path, and rename its tmux session, if it has one. Run it
from inside a linked worktree.

Options:
  -b <new-branch>  New branch name; also the new directory name
  -n <name>        Herdr workspace label (default: the new branch name)
                   and tmux session name (default: <repo>/<new-branch>)
  -y               Don't ask before renaming a remote branch that has an
                   open pull request
  -h, --help       Show this help
EOF
}

usage_rm() {
    cat <<EOF
Usage: $PROG rm [-b <branch>] [-f]
       $PROG rm --merged [-y]

Remove the worktree you're in, or the one that has <branch> checked out.
Close its Herdr workspace and tmux session, if it has them, switching to
another session first if you're in that one. Delete the local branch if
nothing on it would be lost: the default branch already has it, or its pull
request was merged with all of its commits. The branch on origin is never
touched. The main checkout and the default branch's worktree can't be
removed.

With --merged, list every worktree in the repository whose branch nothing
would be lost from, ask, then remove each of them that way, the one whose
tmux session you're in last. Those with uncommitted changes or untracked
files are skipped and listed.

Options:
  -b <branch>   Remove the worktree that has <branch> checked out
  -f            Remove it even with uncommitted changes, untracked files or
                commits that were never pushed
  --merged      Remove every merged worktree, as above
  -y            With --merged, don't ask first
  -h, --help    Show this help
EOF
}

# wants_help <args...>: true if --help appears among the arguments.
wants_help() {
    local arg
    for arg in "$@"; do
        [[ $arg == --help ]] && return 0
    done
    return 1
}

# take_open_flags <command> <args...>: set OPEN_IN to herdr or tmux from
# --herdr or --tmux, drop --no-herdr, which callers still pass but which does
# nothing now, and leave the rest in ARGS.
typeset -g OPEN_IN=
typeset -ga ARGS
take_open_flags() {
    local cmd=$1 arg
    shift
    OPEN_IN= ARGS=()
    for arg in "$@"; do
        case $arg in
            --herdr | --tmux )
                [[ -z $OPEN_IN || $OPEN_IN == ${arg#--} ]] ||
                    usage_error "$cmd" "--tmux and --herdr can't be used together."
                OPEN_IN=${arg#--} ;;
            --no-herdr ) ;;
            * ) ARGS+=("$arg") ;;
        esac
    done
}

# Print $1 relative to $2 (both resolved to absolute paths first).
relpath() {
    local -a target base
    target=("${(s:/:)${1:A}}")
    base=("${(s:/:)${2:A}}")

    local i=1
    while [[ $i -le ${#target} && $i -le ${#base} && "${target[i]}" == "${base[i]}" ]]; do
        (( i++ ))
    done

    local rel="" n=$(( ${#base} - i + 1 ))
    for (( ; n > 0; n-- )); do rel+="../"; done
    for (( ; i <= ${#target}; i++ )); do rel+="${target[i]}/"; done

    rel="${rel%/}"
    print -r -- "${rel:-.}"
}

# Replace a leading $HOME with ~ for display.
tildify() {
    if [[ $1 == $HOME || $1 == $HOME/* ]]; then
        print -r -- "~${1#$HOME}"
    else
        print -r -- "$1"
    fi
}

# The repo's shared git directory as an absolute path with symlinks resolved,
# the same from the main checkout, a linked worktree or a .bare layout root.
common_git_dir() {
    local dir
    dir=$(git rev-parse --git-common-dir)
    print -r -- "${dir:A}"
}

# The repo's default branch: origin's HEAD, else a bare repo's own HEAD,
# else main or master, whichever exists.
detect_default_branch() {
    local ref
    ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    if [[ -n "$ref" ]]; then
        print -r -- "${ref#origin/}"
        return
    fi
    if [[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == true ]] ||
        [[ "$(git --git-dir="$(common_git_dir)" config --bool core.bare 2>/dev/null)" == true ]]; then
        ref=$(git --git-dir="$(common_git_dir)" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
        if [[ -n "$ref" ]] && git show-ref --verify --quiet "refs/heads/$ref"; then
            print -r -- "$ref"
            return
        fi
    fi
    if git show-ref --verify --quiet refs/remotes/origin/main || git show-ref --verify --quiet refs/heads/main; then
        print -r -- "main"
    elif git show-ref --verify --quiet refs/remotes/origin/master || git show-ref --verify --quiet refs/heads/master; then
        print -r -- "master"
    else
        print -r -- "main"
    fi
}

# Print the path of the worktree that has branch $1 checked out, if any.
worktree_for_branch() {
    local line wt=""
    for line in "${(@f)$(git worktree list --porcelain)}"; do
        case $line in
            "worktree "*) wt=${line#worktree } ;;
            "branch refs/heads/$1") print -r -- "$wt"; return 0 ;;
        esac
    done
    return 1
}

# True if $1 is a registered worktree of this repo.
is_worktree() {
    local line want=${1:A}
    for line in "${(@f)$(git worktree list --porcelain)}"; do
        [[ $line == "worktree "* && ${${line#worktree }:A} == $want ]] && return 0
    done
    return 1
}

# org_repo <common-git-dir>: set REPO_ORG and REPO_NAME from origin's URL,
# so git@github.com:acme/widget.git gives acme and widget. Without an origin,
# they're local and the repository's folder name.
typeset -g REPO_ORG= REPO_NAME=
org_repo() {
    local dir=$1 url
    url=$(git config --get remote.origin.url 2>/dev/null || true)
    if [[ -n $url ]]; then
        url=${url#*://}
        url=${url#*@}
        url=${url/://}
        url=${${url%/}%.git}
        REPO_ORG=${url:h:t} REPO_NAME=${url:t}
    elif [[ ${dir:t} == (.git|.bare) ]]; then
        REPO_ORG=local REPO_NAME=${dir:h:t}
    else
        REPO_ORG=local REPO_NAME=${${dir:t}%.git}
    fi
}

# The root that worktrees of normal repos live under.
worktree_root() {
    local root=${WKT_ROOT:-$HOME/.herdr/worktrees}
    root=${root/#\~/$HOME}
    [[ $root == /* ]] || die "WKT_ROOT must be an absolute path, not '$WKT_ROOT'."
    print -r -- "${root%/}"
}

# herdr_open <repo-git-dir> <worktree-path> <label> [<herdr arg>...]
# Open the worktree as a Herdr workspace, or point the one that has it at a
# new path. The git work is already done, so a missing or unreachable Herdr
# only warns; the status says whether it opened.
herdr_open() {
    local repo_dir=$1 wt_path=$2 label=$3
    shift 3
    local -a args=(worktree open --cwd "$repo_dir" --path "$wt_path")
    [[ -n "$label" ]] && args+=(--label "$label")
    args+=("$@")

    if ! command -v herdr >/dev/null 2>&1; then
        warn "herdr not found on PATH; skipped opening the worktree in Herdr."
        return 1
    fi
    local err
    if ! err=$(herdr "${args[@]}" 2>&1 >/dev/null); then
        local -a err_lines=("${(@f)err}")
        warn "Herdr didn't open the worktree${err:+: ${err_lines[1]}}"
        print -ru2 -- "  Is Herdr running? To open it by hand: herdr ${(j: :)${(@q-)args}}"
        return 1
    fi
    return 0
}

# herdr_paths: fill HERDR_PATHS with the worktree paths open as Herdr
# workspaces, each mapped to its workspace's id. Empty if Herdr isn't
# installed or doesn't answer.
typeset -gA HERDR_PATHS
herdr_paths() {
    HERDR_PATHS=()
    command -v herdr >/dev/null 2>&1 || return 0
    local json id found
    json=$(herdr workspace list 2>/dev/null || true)
    # Herdr puts workspace_id just before worktree, so the text up to the
    # next workspace_id holds this workspace's checkout_path, if it has one.
    while [[ $json == *'"workspace_id":"'* ]]; do
        json=${json#*'"workspace_id":"'}
        id=${json%%'"'*}
        found=${json%%'"workspace_id":"'*}
        [[ $found == *'"checkout_path":"'* ]] || continue
        found=${${found#*'"checkout_path":"'}%%'"'*}
        [[ -z $found ]] || HERDR_PATHS[${found:A}]=$id
    done
}

# tmux_sessions: fill TMUX_NAMES, TMUX_TAGS, TMUX_DIRS and TMUX_LAST with each
# tmux session's name, @wkt-worktree, session_path and session_last_attached.
# Empty if tmux isn't installed or no server is running.
typeset -ga TMUX_NAMES TMUX_TAGS TMUX_DIRS TMUX_LAST
tmux_sessions() {
    TMUX_NAMES=() TMUX_TAGS=() TMUX_DIRS=() TMUX_LAST=()
    command -v tmux >/dev/null 2>&1 || return 0
    local line
    local -a row
    for line in ${(f)"$(tmux list-sessions -F $'#{session_name}\t#{@wkt-worktree}\t#{session_path}\t#{session_last_attached}' 2>/dev/null || true)"}; do
        row=("${(@ps:\t:)line}")
        TMUX_NAMES+=("${row[1]}") TMUX_TAGS+=("${row[2]-}") TMUX_DIRS+=("${${row[3]-}:A}")
        TMUX_LAST+=("${${row[4]//[^0-9]/}:-0}")
    done
}

# tmux_find <worktree-path>: the worktree's session, in REPLY: the one tagged
# with its path, else one whose folder is the worktree or inside it, which is
# all tmux-resurrect leaves of a session. Needs tmux_sessions first.
tmux_find() {
    local wt=$1 i=${TMUX_TAGS[(Ie)$1]}
    if (( ! i )); then
        for (( i = 1; i <= ${#TMUX_DIRS}; i++ )); do
            [[ ${TMUX_DIRS[i]} == ($wt|$wt/*) ]] && break
        done
        (( i <= ${#TMUX_DIRS} )) || return 1
    fi
    REPLY=${TMUX_NAMES[i]}
}

# tmux_free <name> <worktree-path>: true unless a session other than the
# worktree's own has the name.
tmux_free() {
    local i=${TMUX_NAMES[(Ie)$1]}
    (( ! i )) || [[ ${TMUX_TAGS[i]} == $2 || ${TMUX_DIRS[i]} == ($2|$2/*) ]]
}

# tmux_name <worktree-path> <branch> [<name>]: the session name for the
# worktree, in REPLY: <name>, else <repo>/<branch>, else <org>/<repo>/<branch>
# if another session has that, then with -2, -3 and so on until it's free.
# tmux reads . and : in a target as separators, so they become -. Needs
# tmux_sessions first.
tmux_name() {
    local wt=$1 name=${3-} n=1
    if [[ -z $name ]]; then
        org_repo "$(common_git_dir)"
        name=$REPO_NAME/$2
        tmux_free "${name//[.:]/-}" "$wt" || name=$REPO_ORG/$name
    fi
    name=${name//[.:]/-}
    REPLY=$name
    while ! tmux_free "$REPLY" "$wt"; do
        REPLY=$name-$(( ++n ))
    done
}

# tmux_open <worktree-path> <branch> [<name>]: switch to the worktree's tmux
# session, making and tagging it first if there's none. Outside tmux, it
# leaves the session to attach to in TMUX_ATTACH instead. What it did goes in
# REPLY. The git work is already done, so a missing or failing tmux only
# warns; the status says whether it opened.
typeset -g TMUX_ATTACH=
tmux_open() {
    local wt=${1:A} name did err
    if ! command -v tmux >/dev/null 2>&1; then
        warn "tmux not found on PATH; skipped opening the worktree in tmux."
        return 1
    fi
    tmux_sessions
    if tmux_find "$wt"; then
        name=$REPLY did="switched to $REPLY"
    else
        tmux_name "$wt" "$2" "${3-}"
        name=$REPLY did="opened in tmux"
        # set-option takes a pane, which an exact =<name> only finds with a :.
        if ! err=$(tmux new-session -d -s "$name" -c "$wt" 2>&1 >/dev/null &&
            tmux set-option -t "=$name:" @wkt-worktree "$wt" 2>&1 >/dev/null); then
            warn "tmux didn't open the worktree${err:+: ${err%%$'\n'*}}"
            return 1
        fi
    fi
    if [[ -z ${TMUX-} ]]; then
        [[ $did == opened* ]] || did="already open in tmux"
        TMUX_ATTACH=$name
    elif ! err=$(tmux switch-client -t "=$name" 2>&1 >/dev/null); then
        warn "tmux didn't switch to $name${err:+: ${err%%$'\n'*}}"
        return 1
    fi
    REPLY=$did
}

# tmux_rename <session> <name> <worktree-path>: rename the session and tag it
# with the worktree's new path. The git work is already done, so a failing
# tmux only warns; the status says whether it was updated.
tmux_rename() {
    local err
    if ! err=$(tmux rename-session -t "=$1" "$2" 2>&1 >/dev/null &&
        tmux set-option -t "=$2:" @wkt-worktree "$3" 2>&1 >/dev/null); then
        warn "tmux didn't update session $1${err:+: ${err%%$'\n'*}}"
        return 1
    fi
}

# tmux_leave <session> <worktree-path>: switch the client from the session to
# the most recently attached other one, or if there's none, to the worktree's,
# opening it. Needs tmux_sessions first. A failing tmux only warns; the status
# says whether the client moved.
tmux_leave() {
    local i to="" last=-1 err
    for (( i = 1; i <= ${#TMUX_NAMES}; i++ )); do
        if [[ ${TMUX_NAMES[i]} != "$1" ]] && (( TMUX_LAST[i] > last )); then
            to=${TMUX_NAMES[i]} last=${TMUX_LAST[i]}
        fi
    done
    if [[ -z $to ]]; then
        tmux_open "$2" "$(git -C "$2" branch --show-current)"
    elif ! err=$(tmux switch-client -t "=$to" 2>&1 >/dev/null); then
        warn "tmux didn't switch to $to${err:+: ${err%%$'\n'*}}"
        return 1
    fi
}

# tmux_kill [<session>]: kill the session, if one is named. A failing tmux
# only warns.
tmux_kill() {
    local err
    [[ -n ${1-} ]] || return 0
    err=$(tmux kill-session -t "=$1" 2>&1 >/dev/null) ||
        warn "tmux didn't close session $1${err:+: ${err%%$'\n'*}}"
}

# unpushed <worktree-path> <default-branch>: the commits at the worktree's
# HEAD that were never pushed: those not on its upstream, else not on origin,
# else, with no origin, not on the local default branch.
unpushed() {
    if git -C "$1" rev-parse --verify --quiet '@{u}' >/dev/null 2>&1; then
        git -C "$1" rev-list '@{u}..HEAD'
    elif git -C "$1" remote get-url origin >/dev/null 2>&1; then
        git -C "$1" rev-list HEAD --not --remotes=origin
    else
        local base
        base=$(git -C "$1" rev-parse --verify --quiet "refs/heads/$2" || true)
        git -C "$1" rev-list HEAD --not ${base}
    fi
}

# in_merged_pr <commit> <pr-state> <pr-head-oid>: true if the pull request was
# merged and its head is the commit or has it, so the commit was pushed even
# if a squash merge left no trace of it on origin. A head that isn't here
# doesn't count.
in_merged_pr() {
    [[ $2 == MERGED ]] && git merge-base --is-ancestor "$1" "$3" 2>/dev/null
}

# is_merged <worktree-path> <branch> <base-ref>: true if nothing at the
# worktree's HEAD would be lost with its branch: <base-ref> has it, or the
# branch's merged pull request does. Asks gh only when <base-ref> doesn't,
# and leaves the pull request's state in PR_STATE.
typeset -g PR_STATE=
is_merged() {
    local head pr oid
    PR_STATE=
    head=$(git -C "$1" rev-parse HEAD)
    git merge-base --is-ancestor "$head" "$3" 2>/dev/null && return 0
    [[ -n $2 ]] && command -v gh >/dev/null 2>&1 || return 1
    pr=$(gh pr view "$2" --json state,headRefOid --jq '[.state,.headRefOid]|@tsv' 2>/dev/null || true)
    IFS=$'\t' read -r PR_STATE oid <<<"$pr" || true
    in_merged_pr "$head" "$PR_STATE" "$oid"
}

# main_worktree <common-git-dir> <default-branch>: where to go when a worktree
# is removed: the main checkout, or in a .bare layout the default branch's
# worktree, else the layout's folder.
main_worktree() {
    if [[ ${1:t} == .bare ]]; then
        worktree_for_branch "$2" || print -r -- "${1:h}"
    else
        local -a lines=("${(@f)$(git worktree list --porcelain)}")
        print -r -- "${lines[1]#worktree }"
    fi
}

# drop_empty_dirs <worktree-path> <branch>: remove the folders a branch name
# with slashes left empty above a worktree that has moved or gone.
drop_empty_dirs() {
    [[ $1 == */"$2" ]] || return 0
    local base=${1%/"$2"} dir=${1:h}
    while [[ $dir == "$base"/* ]] && rmdir "$dir" 2>/dev/null; do
        dir=${dir:h}
    done
}

cmd_setup() {
    wants_help "$@" && { usage_setup; exit 0; }
    [[ $# -eq 0 ]] && usage_error setup "Repo URL is required."
    [[ $1 == -* ]] && usage_error setup "Unknown option: $1"
    [[ $# -gt 1 ]] && usage_error setup "Unexpected argument: $2"
    local repo_url=$1

    if [[ -n "$(ls -A . 2>/dev/null)" ]]; then
        die "Current directory is not empty." "Run '$PROG setup' in a new, empty directory."
    fi

    step "cloning $repo_url into .bare"
    git clone --bare "$repo_url" .bare
    print -r -- "gitdir: ./.bare" > .git
    git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"

    step "fetching origin"
    git fetch origin
    git remote set-head origin --auto >/dev/null 2>&1 || true

    local default_branch
    default_branch=$(detect_default_branch)

    step "adding worktree for $default_branch"
    git worktree add "$default_branch" "$default_branch"
    if git show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
        git branch --quiet --set-upstream-to="origin/$default_branch" "$default_branch" 2>/dev/null || true
    fi

    print -r -- "${OUT_GREEN}✓${OUT_RESET} .bare worktree layout ready  ${OUT_BLUE}${default_branch}${OUT_RESET}"
}

cmd_adopt() {
    wants_help "$@" && { usage_adopt; exit 0; }
    if [[ $# -gt 0 ]]; then
        [[ $1 == -* ]] && usage_error adopt "Unknown option: $1"
        usage_error adopt "Unexpected argument: $1"
    fi

    git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a Git worktree."
    [[ ${$(common_git_dir):t} != .bare ]] || die "This is already a .bare layout."
    [[ "$(git rev-parse --is-inside-work-tree)" == true ]] || die "Not inside a Git worktree."

    local root
    root=$(git rev-parse --show-toplevel)
    root=${root:A}
    [[ ${PWD:A} == $root ]] ||
        die "Run '$PROG adopt' from the top of the clone." "That's $(tildify "$root")."
    [[ -d .git ]] ||
        die "'.git' isn't a folder, so this is a linked worktree or a submodule." \
            "Run '$PROG adopt' in the repository's main checkout."
    [[ ! -e .bare ]] || die "'.bare' already exists."
    [[ ! -e .gitmodules && ! -e .git/modules ]] ||
        die "Repositories with submodules aren't supported."

    local branch
    branch=$(git branch --show-current)
    [[ -n $branch ]] ||
        die "Detached HEAD." "Check out a branch first; the worktree is named after it."
    git rev-parse --verify --quiet HEAD >/dev/null || die "'$branch' has no commits yet."

    local state
    for state in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG rebase-merge rebase-apply sequencer; do
        [[ ! -e .git/$state ]] ||
            die "A merge, rebase, cherry-pick, revert or bisect is in progress." \
                "Finish or abort it, then try again."
    done

    # Stage the working tree in a hidden folder first, so a top-level entry
    # sharing the branch's name can't get in the way of the worktree path.
    local stage="$root/.wkt-adopt.$$" wt_path="$root/$branch"
    local files_at=$root repo_at="$root/.git"
    trap 'print -ru2 -- "  adopt stopped partway; nothing was deleted. Your files are in $(tildify "$files_at"), the repository in $(tildify "$repo_at")."' ZERR

    local -a entries=( *(DN) ) linked=() line
    entries=( ${entries:#.git} )
    for line in "${(@f)$(git worktree list --porcelain)}"; do
        if [[ $line == "worktree "* && ${${line#worktree }:A} != $root ]]; then
            linked+=("${line#worktree }")
        fi
    done

    step "moving the working tree aside"
    mkdir "$stage"
    files_at=$stage
    if (( ${#entries} )); then
        mv -- "${entries[@]}" "$stage/"
    fi

    step "moving .git to .bare"
    mv .git .bare
    repo_at="$root/.bare"
    print -r -- "gitdir: ./.bare" > .git
    git config core.bare true

    step "adding worktree for $branch"
    git worktree add --quiet --no-checkout "$branch" "$branch"
    mv "$wt_path/.git" "$stage/.git"
    rmdir "$wt_path"
    mv "$stage" "$wt_path"
    files_at=$wt_path

    # The old index carries what was staged; a fresh one would unstage it.
    local wt_git_dir
    wt_git_dir=$(git -C "$wt_path" rev-parse --absolute-git-dir)
    if [[ -f .bare/index ]]; then
        mv .bare/index "$wt_git_dir/index"
    else
        git -C "$wt_path" reset --quiet
    fi
    git -C "$wt_path" update-index -q --refresh >/dev/null 2>&1 || true

    # Linked worktrees made before still point at .git. Repair also rewrites
    # ./.git with an absolute path, so put the relative one back.
    if (( ${#linked} )); then
        git worktree repair "${linked[@]}" >/dev/null 2>&1 || true
        print -r -- "gitdir: ./.bare" > .git
    fi
    trap - ZERR

    print -r -- "${OUT_GREEN}✓${OUT_RESET} .bare worktree layout ready  ${OUT_BLUE}${branch}${OUT_RESET}"
    print -r -- "${OUT_YELLOW}→${OUT_RESET} your files moved into ./$branch; run: cd ${(q-)branch}"
    print -r -- "${OUT_YELLOW}→${OUT_RESET} editors and tools that remember absolute paths (direnv, mise trust) need the new folder"
}

cmd_new() {
    wants_help "$@" && { usage_new; exit 0; }
    take_open_flags new "$@"
    set -- "${ARGS[@]}"
    local new_branch="" source_branch="" label="" opt
    local OPTIND=1 OPTARG
    while getopts ":b:s:n:h" opt; do
        case $opt in
            b ) new_branch=$OPTARG ;;
            s ) source_branch=$OPTARG ;;
            n ) label=$OPTARG ;;
            h ) usage_new; exit 0 ;;
            : ) usage_error new "Option -$OPTARG needs a value." ;;
            * ) usage_error new "Unknown option: -$OPTARG" ;;
        esac
    done
    shift $(( OPTIND - 1 ))
    [[ $# -gt 0 ]] && usage_error new "Unexpected argument: $1"
    [[ -z "$new_branch" ]] && usage_error new "Branch name (-b) is required."

    git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a Git repository."
    git check-ref-format --branch "$new_branch" >/dev/null 2>&1 ||
        die "'$new_branch' is not a valid branch name."

    local common_dir target_path is_bare
    common_dir=$(common_git_dir)

    if [[ ${common_dir:t} == .bare ]]; then
        # .bare layout: worktrees live next to .bare/.
        is_bare=1
        target_path="${common_dir:h}/${new_branch}"
    else
        # Normal repo: keep worktrees out of the checkout, under
        # <root>/<org>/<repo>/<branch>, named from origin's URL.
        is_bare=0
        org_repo "$common_dir"
        local root
        root=$(worktree_root)
        target_path="${root}/${REPO_ORG}/${REPO_NAME}/${new_branch}"
    fi

    local existing
    existing=$(worktree_for_branch "$new_branch" || true)

    if [[ -n "$existing" ]]; then
        target_path=$existing
    elif [[ -d "$target_path" ]]; then
        if ! is_worktree "$target_path"; then
            git worktree repair "$target_path" >/dev/null 2>&1 || true
            is_worktree "$target_path" ||
                die "'$target_path' exists and isn't a worktree of this repo." \
                    "Move or remove it, then try again."
        fi
    elif git show-ref --verify --quiet "refs/heads/$new_branch"; then
        git worktree add "$target_path" "$new_branch" >/dev/null
    elif git show-ref --verify --quiet "refs/remotes/origin/$new_branch"; then
        git worktree add --track -b "$new_branch" "$target_path" "origin/$new_branch" >/dev/null
    else
        [[ -z "$source_branch" ]] && source_branch=$(detect_default_branch)

        if git remote get-url origin >/dev/null 2>&1; then
            step "updating $source_branch from origin"
            git fetch origin "$source_branch" >/dev/null 2>&1 || true
        fi

        local base_ref
        if git show-ref --verify --quiet "refs/remotes/origin/$source_branch"; then
            base_ref="origin/$source_branch"
        elif git rev-parse --verify --quiet "${source_branch}^{commit}" >/dev/null; then
            base_ref=$source_branch
        else
            die "Source branch '$source_branch' not found locally or on origin."
        fi

        step "branching from $base_ref"
        git worktree add --no-track -b "$new_branch" "$target_path" "$base_ref" >/dev/null
    fi

    local open_note="" opened=0
    if [[ $OPEN_IN == herdr ]] && herdr_open "$common_dir" "$target_path" "$label" --focus; then
        open_note="  ${OUT_BLUE}opened in Herdr${OUT_RESET}"
        opened=1
    elif [[ $OPEN_IN == tmux ]] && tmux_open "$target_path" "$new_branch" "$label"; then
        open_note="  ${OUT_BLUE}${REPLY}${OUT_RESET}"
    fi

    local display_path
    if [[ $is_bare -eq 1 ]]; then
        display_path=$(relpath "$target_path" "$PWD")
    else
        display_path=$(tildify "$target_path")
    fi

    print -r -- "${OUT_GREEN}✓${OUT_RESET} ${new_branch}${label:+ ($label)}  ${display_path}${open_note}"
    [[ -z $TMUX_ATTACH ]] || step "attach with: tmux attach -t ${(q-)TMUX_ATTACH}"
    typeset -g WKT_PATH=$target_path WKT_HERDR_OPENED=$opened
}

cmd_rename() {
    wants_help "$@" && { usage_rename; exit 0; }
    take_open_flags rename "$@"
    [[ -z $OPEN_IN ]] ||
        usage_error rename "rename doesn't take --$OPEN_IN; it updates a worktree's Herdr workspace and tmux session on its own."
    set -- "${ARGS[@]}"
    local new_branch="" new_name="" auto_yes=0 opt
    local OPTIND=1 OPTARG
    while getopts ":b:n:yh" opt; do
        case $opt in
            b ) new_branch=$OPTARG ;;
            n ) new_name=$OPTARG ;;
            y ) auto_yes=1 ;;
            h ) usage_rename; exit 0 ;;
            : ) usage_error rename "Option -$OPTARG needs a value." ;;
            * ) usage_error rename "Unknown option: -$OPTARG" ;;
        esac
    done
    shift $(( OPTIND - 1 ))
    [[ $# -gt 0 ]] && usage_error rename "Unexpected argument: $1"
    [[ -z "$new_branch" ]] && usage_error rename "New branch name (-b) is required."

    [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" == true ]] ||
        die "Not inside a Git worktree."

    local git_dir common_dir
    git_dir=$(git rev-parse --absolute-git-dir)
    git_dir=${git_dir:A}
    common_dir=$(common_git_dir)

    if [[ "$git_dir" == "$common_dir" ]]; then
        die "Refusing to rename the main checkout." \
            "Run this from inside a linked worktree created by '$PROG new'."
    fi

    local old_branch
    old_branch=$(git branch --show-current)
    [[ -n "$old_branch" ]] || die "Detached HEAD; nothing to rename."
    [[ "$new_branch" != "$old_branch" ]] || die "'$new_branch' is already the current branch name."
    git check-ref-format --branch "$new_branch" >/dev/null 2>&1 ||
        die "'$new_branch' is not a valid branch name."
    ! git show-ref --verify --quiet "refs/heads/$new_branch" ||
        die "Branch '$new_branch' already exists."

    # The worktree directory is named after the branch, which may contain
    # slashes, so swap the branch suffix rather than just the last component.
    local old_path new_path base
    old_path=$(git rev-parse --show-toplevel)
    old_path=${old_path:A}
    if [[ $old_path == */$old_branch ]]; then
        base=${old_path%/$old_branch}
    else
        base=${old_path:h}
    fi
    new_path="${base}/${new_branch}"

    [[ ! -e "$new_path" ]] || die "'$new_path' already exists."

    local remote_url has_remote_branch=0
    remote_url=$(git config --get remote.origin.url 2>/dev/null || true)
    if [[ -n "$remote_url" ]] && git show-ref --verify --quiet "refs/remotes/origin/$old_branch"; then
        has_remote_branch=1
    fi

    if [[ $has_remote_branch -eq 1 ]]; then
        local pr_line="" pr_number="" pr_state="" pr_url="" pr_open=0
        if command -v gh >/dev/null 2>&1; then
            pr_line=$(gh pr view "$old_branch" --json number,state,url --jq '[.number,.state,.url]|@tsv' 2>/dev/null || true)
            if [[ -n "$pr_line" ]]; then
                IFS=$'\t' read -r pr_number pr_state pr_url <<< "$pr_line"
                [[ "$pr_state" == "OPEN" ]] && pr_open=1
            fi
        fi

        # Neither GitHub's branch-rename API nor push+delete keeps an open PR
        # attached to the renamed branch; GitHub closes it. Only the rename
        # button in GitHub's web UI migrates an open PR.
        if [[ $pr_open -eq 1 && $auto_yes -eq 0 ]]; then
            warn "PR #$pr_number is open for '$old_branch' ($pr_url)."
            print -ru2 -- "  Renaming the remote branch will close that PR: GitHub doesn't carry an open"
            print -ru2 -- "  PR across a branch rename done with git or gh, so you'd need a new PR."
            print -ru2 -- "  To keep the PR, rename the branch in GitHub's web UI instead, then run"
            print -ru2 -- "  '$PROG rename' here to bring the local branch, directory, Herdr workspace and"
            print -ru2 -- "  tmux session in line."
            print -ru2 -- "  Pass -y to rename anyway and close the PR."
            [[ -t 0 ]] || die "No terminal to confirm; pass -y to proceed. Nothing was changed."
            printf "  Continue anyway? [y/N] " >&2
            local reply=""
            read -r reply || true
            [[ "$reply" == [yY]* ]] || die "Aborted. Nothing was changed."
        fi

        local renamed_remote=0 gh_err=""
        if [[ "$remote_url" == *github.com* ]] && command -v gh >/dev/null 2>&1; then
            if gh_err=$(gh api --method POST "repos/{owner}/{repo}/branches/${old_branch}/rename" -f new_name="$new_branch" 2>&1); then
                renamed_remote=1
                step "renamed remote branch with the GitHub API"
            else
                warn "GitHub's branch-rename API failed, falling back to push and delete:"
                print -ru2 -- "  $gh_err"
            fi
        fi

        if [[ $renamed_remote -eq 0 ]]; then
            step "pushing '$new_branch' to origin"
            git push origin "refs/heads/${old_branch}:refs/heads/${new_branch}"
            step "deleting '$old_branch' from origin"
            git push origin --delete "$old_branch"
        fi

        step "syncing remote-tracking branches"
        git fetch --prune origin >/dev/null 2>&1 || true
    fi

    git branch -m "$old_branch" "$new_branch"

    if [[ $has_remote_branch -eq 1 ]]; then
        git branch --quiet --set-upstream-to="origin/$new_branch" "$new_branch" 2>/dev/null || true
    fi

    local had_workspace=0 session="" session_name=""
    herdr_paths
    [[ -z ${HERDR_PATHS[$old_path]-} ]] || had_workspace=1
    tmux_sessions
    if tmux_find "$old_path"; then
        session=$REPLY
        tmux_name "$old_path" "$new_branch" "$new_name"
        session_name=$REPLY
    fi

    mkdir -p "${new_path:h}"
    git -C "$common_dir" worktree move "$old_path" "$new_path"
    drop_empty_dirs "$old_path" "$old_branch"

    local notes=""
    if (( had_workspace )) && herdr_open "$common_dir" "$new_path" "${new_name:-$new_branch}"; then
        notes+="  ${OUT_BLUE}Herdr workspace updated${OUT_RESET}"
    fi
    if [[ -n $session ]] && tmux_rename "$session" "$session_name" "$new_path"; then
        notes+="  ${OUT_BLUE}tmux session renamed to ${session_name}${OUT_RESET}"
    fi

    print -r -- "${OUT_GREEN}✓${OUT_RESET} ${old_branch} → ${new_branch}  $(tildify "$new_path")${notes}"
    print -r -- "${OUT_YELLOW}→${OUT_RESET} your shell is still in the old directory; run: cd ${(q-)new_path}"
}

# rm_worktree <worktree-path> <branch> <force> <common-git-dir> <home> [<why-kept>]:
# remove the worktree and the folders it leaves empty, delete its branch
# unless given a reason to keep it, close its Herdr workspace, leave its tmux
# session if you're in it, and print what went. If git can't remove it, it
# stops there with git's status. The session is left in RM_SESSION for the
# caller to kill after all output; RM_MOVED says whether the client moved.
typeset -g RM_SESSION= RM_MOVED=0
rm_worktree() {
    local wt=$1 branch=$2 force=$3 common_dir=$4 home=$5 kept=${6-}
    local ws session="" notes="" err target
    RM_SESSION= RM_MOVED=0
    herdr_paths
    ws=${HERDR_PATHS[$wt]-}
    tmux_sessions
    if tmux_find "$wt"; then
        session=$REPLY
    fi
    # Later git and tmux calls need a current folder that outlives the worktree.
    cd "$common_dir"

    # rm --merged calls this with err_exit off, so git's failures return here.
    local -a remove=(worktree remove)
    (( ! force )) || remove+=(--force)
    git "${remove[@]}" "$wt" || return
    drop_empty_dirs "$wt" "$branch"

    if [[ -n $branch && -z $kept ]]; then
        git branch -D "$branch" >/dev/null || return
        notes="  ${OUT_BLUE}branch deleted${OUT_RESET}"
    elif [[ -n $branch ]]; then
        notes="  ${OUT_BLUE}branch kept: ${kept}${OUT_RESET}"
    fi

    if [[ -n $ws ]]; then
        if err=$(herdr workspace close "$ws" 2>&1 >/dev/null); then
            notes+="  ${OUT_BLUE}Herdr workspace closed${OUT_RESET}"
        else
            warn "Herdr didn't close the workspace${err:+: ${err%%$'\n'*}}"
            print -ru2 -- "  To close it by hand: herdr workspace close ${(q-)ws}"
        fi
    fi

    if [[ -n $session && -n ${TMUX-} ]] &&
        [[ "$(tmux display-message -p '#{session_name}' 2>/dev/null || true)" == "$session" ]]; then
        if tmux_leave "$session" "$home"; then
            RM_MOVED=1
        else
            target="=$session"
            print -ru2 -- "  Left $session open; to close it: tmux kill-session -t ${(q-)target}"
            session=""
        fi
    fi
    [[ -z $session ]] || notes+="  ${OUT_BLUE}tmux session ${session} closed${OUT_RESET}"

    print -r -- "${OUT_GREEN}✓${OUT_RESET} removed ${branch:-${wt:t}}  $(tildify "$wt")${notes}"
    RM_SESSION=$session
}

# rm_merged <yes> <common-git-dir> <default-branch> <base-ref> <home>: list
# every worktree on a branch that is_merged passes, apart from the main
# checkout and the default branch's, skipping those with changes. Ask unless
# <yes>, then remove each with rm_worktree, the one whose tmux session you're
# in last. Exits 1 if any failed.
rm_merged() {
    local yes=$1 common_dir=$2 default=$3 base=$4 home=$5
    local -a lines=("${(@f)$(git worktree list --porcelain)}") go=() go_b=() skip=() skip_b=()
    local main=${${lines[1]#worktree }:A} here line wt="" branch i
    here=$(git rev-parse --show-toplevel 2>/dev/null || true)
    [[ -z $here ]] || here=${here:A}
    for line in "${lines[@]}"; do
        case $line in
            "worktree "* ) wt=${${line#worktree }:A} ;;
            "branch refs/heads/"* )
                branch=${line#branch refs/heads/}
                [[ $wt != "$main" && $branch != "$default" && -d $wt ]] || continue
                is_merged "$wt" "$branch" "$base" || continue
                if [[ -z "$(git -C "$wt" status --porcelain)" ]]; then
                    go+=("$wt") go_b+=("$branch")
                else
                    skip+=("$wt") skip_b+=("$branch")
                fi ;;
        esac
    done

    local n=${#go} s=s reply="" current removed=0 failed=0 gone_here=0 last=""
    if (( n )); then
        print -r -- "Merged worktrees to remove:"
        for (( i = 1; i <= n; i++ )); do
            print -r -- "  ${go_b[i]}  $(tildify "${go[i]}")"
        done
    else
        print -r -- "No merged worktrees to remove."
    fi
    (( ! ${#skip} )) || print -r -- "Skipping:"
    for (( i = 1; i <= ${#skip}; i++ )); do
        print -r -- "  ${skip_b[i]}  $(tildify "${skip[i]}")  (uncommitted changes or untracked files)"
    done
    (( n )) || return 0

    (( n > 1 )) || s=
    if (( ! yes )); then
        [[ -t 0 || -n ${WKT_ASSUME_TTY-} ]] ||
            die "No terminal to confirm; pass -y to remove them. Nothing was changed."
        printf "Remove %d merged worktree%s? [y/N] " "$n" "$s" >&2
        read -r reply || true
        [[ $reply == [yY]* ]] || die "Aborted. Nothing was changed."
    fi

    if [[ -n ${TMUX-} ]] && (( n > 1 )); then
        current=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
        tmux_sessions
        for (( i = 1; i < n; i++ )); do
            tmux_find "${go[i]}" && [[ $REPLY == "$current" ]] || continue
            go+=("${go[i]}") go_b+=("${go_b[i]}")
            go[i]=() go_b[i]=()
            break
        done
    fi

    for (( i = 1; i <= n; i++ )); do
        if rm_worktree "${go[i]}" "${go_b[i]}" 0 "$common_dir" "$home"; then
            (( ++removed ))
            [[ ${go[i]} != "$here" ]] || (( RM_MOVED )) || gone_here=1
            if (( RM_MOVED )); then last=$RM_SESSION; else tmux_kill "$RM_SESSION"; fi
        else
            (( ++failed ))
            warn "${go_b[i]} wasn't removed; carrying on with the rest."
        fi
    done

    local summary="removed $removed"
    (( ! failed )) || summary+=", failed $failed"
    summary+=", skipped ${#skip}"
    if (( failed )); then
        print -ru2 -- "${ERR_RED}error:${ERR_RESET} $summary"
    else
        print -r -- "${OUT_GREEN}✓${OUT_RESET} $summary"
    fi
    (( ! gone_here )) || step "your folder is gone; run: cd ${(q-)home}"
    # Last, after all output: wkt is likely running in this session.
    tmux_kill "$last"
    (( ! failed )) || exit 1
}

cmd_rm() {
    wants_help "$@" && { usage_rm; exit 0; }
    take_open_flags rm "$@"
    [[ -z $OPEN_IN ]] ||
        usage_error rm "rm doesn't take --$OPEN_IN; it closes a worktree's Herdr workspace and tmux session on its own."
    set -- "${ARGS[@]}"
    local named="" force=0 all=0 yes=0 opt
    if (( ${argv[(Ie)--merged]} )); then
        all=1
        set -- "${(@)argv:#--merged}"
    fi
    local OPTIND=1 OPTARG
    while getopts ":b:fyh" opt; do
        case $opt in
            b ) named=$OPTARG ;;
            f ) force=1 ;;
            y ) yes=1 ;;
            h ) usage_rm; exit 0 ;;
            : ) usage_error rm "Option -$OPTARG needs a value." ;;
            * ) usage_error rm "Unknown option: -$OPTARG" ;;
        esac
    done
    shift $(( OPTIND - 1 ))
    [[ $# -gt 0 ]] && usage_error rm "Unexpected argument: $1"
    if (( all )); then
        [[ -z $named ]] && (( ! force )) || usage_error rm "--merged can't be used with -b or -f."
    else
        (( ! yes )) || usage_error rm "-y only goes with --merged."
    fi

    git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a Git repository."
    local common_dir default base home
    common_dir=$(common_git_dir)
    default=$(detect_default_branch)
    base=refs/heads/$default
    git remote get-url origin >/dev/null 2>&1 && base=refs/remotes/origin/$default
    home=$(main_worktree "$common_dir" "$default")
    if (( all )); then
        rm_merged "$yes" "$common_dir" "$default" "$base" "$home"
        return
    fi

    local wt branch=$named git_dir
    if [[ -n $named ]]; then
        wt=$(worktree_for_branch "$named" || true)
        [[ -n $wt ]] || die "No worktree has '$named' checked out."
    else
        [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" == true ]] ||
            die "Not inside a Git worktree." "Run it from the worktree to remove, or name its branch with -b."
        wt=$(git rev-parse --show-toplevel)
        branch=$(git branch --show-current)
    fi
    wt=${wt:A}
    git_dir=$(git -C "$wt" rev-parse --absolute-git-dir)
    [[ ${git_dir:A} != "$common_dir" ]] || die "Refusing to remove the main checkout."
    [[ $branch != "$default" ]] ||
        die "Refusing to remove the default branch's worktree."

    local label=${branch:-${wt:t}} dirty
    if (( ! force )); then
        dirty=$(git -C "$wt" status --porcelain)
        [[ -z $dirty ]] ||
            die "'$label' has uncommitted changes or untracked files." \
                "Commit, stash or delete them, or pass -f to remove it anyway."
    fi

    local kept="" ahead
    # Asked before the folder goes, as gh may be running from it.
    if ! is_merged "$wt" "$branch" "$base"; then
        if (( ! force )); then
            ahead=$(unpushed "$wt" "$default")
            [[ -z $ahead ]] ||
                die "'$label' has commits that were never pushed." "Push them, or pass -f to remove it anyway."
        fi
        kept="not merged into ${base#refs/*/}"
        [[ $PR_STATE != MERGED ]] || kept="has commits not in the merged PR"
    fi

    rm_worktree "$wt" "$branch" "$force" "$common_dir" "$home" "$kept"
    [[ -n $named ]] || (( RM_MOVED )) || step "your folder is gone; run: cd ${(q-)home}"
    # Last, after all output: wkt is likely running in this session.
    tmux_kill "$RM_SESSION"
}

# ui_theme: pick light or dark (WKT_THEME, then theme-monitor's trigger file,
# then macOS) into UI_THEME, and fill PAL and the glyphs to match.
typeset -gA PAL
typeset -g UI_THEME=light
ui_theme() {
    # The glyph escapes need a UTF-8 character set.
    zmodload zsh/langinfo 2>/dev/null || true
    if [[ ${langinfo[CODESET]-} != UTF-8 ]]; then
        local loc
        for loc in en_US.UTF-8 C.UTF-8; do
            if [[ -n ${LC_ALL-} ]]; then export LC_ALL=$loc; else export LC_CTYPE=$loc; fi
            [[ ${langinfo[CODESET]-} != UTF-8 ]] || break
        done
    fi

    local theme=${(L)${WKT_THEME-}}
    if [[ $theme != (light|dark) ]]; then
        local data=${XDG_DATA_HOME-} file
        [[ $data == /* ]] || data=$HOME/.local/share
        file=$data/theme-monitor/theme-change.trigger
        theme=""
        if [[ -r $file ]]; then
            theme=${"$(<$file)"//[[:space:]]/}
        fi
        if [[ $theme != (light|dark) ]]; then
            theme=light
            if [[ $OSTYPE == darwin* ]] && command -v defaults >/dev/null 2>&1; then
                local style
                style=$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)
                [[ $style != Dark ]] || theme=dark
            fi
        fi
    fi
    UI_THEME=$theme

    # Catppuccin Macchiato and Latte, as in herdr-projects' theme.py.
    if [[ $theme == dark ]]; then
        PAL=(
            base '36;39;58'       surface0 '54;58;79'    surface1 '73;77;100'
            surface2 '91;96;120'  overlay0 '110;115;141' overlay1 '128;135;162'
            subtext0 '165;173;203' text '202;211;245'
            green '166;218;149'   red '237;135;150'      yellow '238;212;159'
            peach '245;169;127'   mauve '198;160;246'    blue '138;173;244'
        )
    else
        PAL=(
            base '239;241;245'    surface0 '204;208;218' surface1 '188;192;204'
            surface2 '172;176;190' overlay0 '156;160;176' overlay1 '140;143;161'
            subtext0 '108;111;133' text '76;79;105'
            green '64;160;43'     red '210;15;57'        yellow '223;142;29'
            peach '254;100;11'    mauve '136;57;239'     blue '30;102;245'
        )
    fi

    typeset -g UI_ICO_BRANCH=$'\uf418'     # nf-oct-git_branch
    typeset -g UI_ICO_HOME=$'\uf46d'       # nf-oct-home
    typeset -g UI_ICO_COMMIT=$'\uf417'     # nf-oct-git_commit
    typeset -g UI_ICO_CURRENT=$'\uf111'    # nf-fa-circle
    typeset -g UI_ICO_OPEN=$'\uf4aa'       # nf-oct-circle
    typeset -g UI_ICO_MISSING=$'\U000f0338' # nf-md-link_off
    typeset -g UI_ICO_LOCKED=$'\uf456'     # nf-oct-lock
    typeset -g UI_ICO_ALERT=$'\uf421'      # nf-oct-alert
    typeset -g UI_ENTER=$'\u21b5' UI_ELLIPSIS=$'\u2026'
}

# ui_paint <colour> [bold|dim] <text>: the text in a PAL colour, in REPLY.
ui_paint() {
    local colour=$1 attr=""
    shift
    if (( $# > 1 )); then
        case $1 in
            bold ) attr="1;" ;;
            dim ) attr="2;" ;;
        esac
        shift
    fi
    if [[ -n ${NO_COLOR-} ]]; then
        REPLY=$1
    else
        REPLY=$'\e['"${attr}38;2;${PAL[$colour]}m$1"$'\e[0m'
    fi
}

# ui_header <hints> [<title>] [<notice>]: fzf's three header rows, in REPLY.
# The notice comes painted.
ui_header() {
    local hints=$1 title=${2-} notice=${3-} line
    if [[ -n $title ]]; then
        ui_paint overlay0 dim " · $hints"
        line=$REPLY
        ui_paint text bold "$title"
        line=$REPLY$line
    else
        ui_paint overlay0 dim "$hints"
        line=$REPLY
    fi
    REPLY=" "$'\n'"$line"$'\n'"${notice:- }"
}

# ui_clip <cells> <text> [left]: the text cut to fit, an ellipsis marking the
# cut at its end, or its start with 'left'. In REPLY.
ui_clip() {
    local -i cells=$1
    local text=$2
    if (( ${(m)#text} <= cells )); then
        REPLY=$text
    elif (( cells < 1 )); then
        REPLY=""
    elif [[ ${3-} == left ]]; then
        (( ${#text} <= cells )) || text=${text[-cells,-1]}
        while (( ${(m)#text} > cells - 1 )); do text=${text[2,-1]}; done
        REPLY=$UI_ELLIPSIS$text
    else
        (( ${#text} <= cells )) || text=${text[1,cells]}
        while (( ${(m)#text} > cells - 1 )); do text=${text[1,-2]}; done
        REPLY=$text$UI_ELLIPSIS
    fi
}

# ui_width: the cells a list row may take, in REPLY: the terminal less the
# preview's 40% and fzf's pointer, marker and scrollbar columns.
ui_width() {
    local size cols
    size=$({ stty size </dev/tty } 2>/dev/null || true)
    cols=${${(z)size}[2]-}
    [[ $cols == <-> ]] || cols=${COLUMNS-}
    [[ $cols == <-> ]] && (( cols > 0 )) || cols=80
    REPLY=$(( cols * 60 / 100 - 3 ))
    (( REPLY >= 20 )) || REPLY=20
}

# ui_fzf <prompt> <header> [<fzf args>...]: fzf with the picker's shared look.
ui_fzf() {
    local prompt=$1 header=$2
    shift 2
    fzf --ansi --layout=reverse --height=100% --border=none --margin=0 --padding=0 --no-info \
        --prompt "$prompt" --header "$header" "$@" || return
}

# ui_parse <fzf output>: split what fzf printed with --print-query and
# --expect into UI_QUERY, UI_KEY and UI_SEL.
typeset -g UI_QUERY= UI_KEY= UI_SEL=
ui_parse() {
    local -a lines=("${(@f)1}")
    UI_QUERY=${lines[1]-} UI_KEY=${lines[2]-} UI_SEL=${lines[3]-}
}

# ui_rows: fill UI_ROWS with one fzf row per worktree, default branch first,
# and UI_AT with the current worktree's row, or 0. A row is
# head<TAB>branch<TAB>tail<TAB>path; fzf shows a tab as one cell.
typeset -ga UI_ROWS
typeset -gi UI_AT=0
ui_rows() {
    local common_dir default here
    common_dir=$(common_git_dir)
    default=$(detect_default_branch)
    here=$(git rev-parse --show-toplevel 2>/dev/null || true)
    [[ -z $here ]] || here=${here:A}

    local -a e_path e_branch e_head e_flag
    local line wt="" head="" branch="" flag="" bare=0
    for line in "${(@f)$(git worktree list --porcelain)}" ""; do
        case $line in
            "worktree "* ) wt=${line#worktree } ;;
            "HEAD "* ) head=${line#HEAD } ;;
            "branch refs/heads/"* ) branch=${line#branch refs/heads/} ;;
            bare ) bare=1 ;;
            prunable | "prunable "* ) flag=missing ;;
            locked | "locked "* ) [[ $flag == missing ]] || flag=locked ;;
            "" )
                if [[ -n $wt ]] && (( ! bare )); then
                    if [[ -n $branch && $branch == $default ]]; then
                        e_path=("$wt" "${e_path[@]}") e_branch=("$branch" "${e_branch[@]}")
                        e_head=("$head" "${e_head[@]}") e_flag=("$flag" "${e_flag[@]}")
                    else
                        e_path+=("$wt") e_branch+=("$branch") e_head+=("$head") e_flag+=("$flag")
                    fi
                fi
                wt="" head="" branch="" flag="" bare=0 ;;
        esac
    done

    local -a names shown
    local base=${common_dir:h} name i
    for (( i = 1; i <= ${#e_path}; i++ )); do
        wt=${e_path[i]}
        names+=("${e_branch[i]:-${e_head[i][1,7]}}")
        if [[ ${common_dir:t} == .bare && ${wt#$base/} == ${e_branch[i]} ]]; then
            shown+=("")
        elif [[ ${common_dir:t} == .bare && $wt == $base/* ]]; then
            shown+=("${wt#$base/}")
        elif [[ $wt == $HOME || $wt == $HOME/* ]]; then
            shown+=("~${wt#$HOME}")
        else
            shown+=("$wt")
        fi
    done

    # Cells: an icon and a gap, the branch column, a gap, the path, the status.
    local -i width label_end=0 room pad fill
    ui_width
    width=$REPLY
    room=$(( width - 6 ))
    for name in "${names[@]}"; do
        (( ${(m)#name} <= label_end )) || label_end=${(m)#name}
    done
    (( label_end <= room )) || label_end=room

    local icon status_icon label path_text sp=""
    UI_ROWS=() UI_AT=0
    for (( i = 1; i <= ${#e_path}; i++ )); do
        wt=${e_path[i]}
        if [[ -z ${e_branch[i]} ]]; then
            icon=$UI_ICO_COMMIT
        elif [[ ${e_branch[i]} == $default ]]; then
            icon=$UI_ICO_HOME
        else
            icon=$UI_ICO_BRANCH
        fi
        ui_paint overlay1 "$icon"
        icon=$REPLY

        if [[ -n $here && ${wt:A} == $here ]]; then
            UI_AT=$i
            ui_paint green bold "$UI_ICO_CURRENT"
        elif [[ ${e_flag[i]} == missing ]]; then
            ui_paint red "$UI_ICO_MISSING"
        elif [[ ${e_flag[i]} == locked ]]; then
            ui_paint yellow "$UI_ICO_LOCKED"
        elif [[ -n ${HERDR_PATHS[${wt:A}]-} ]]; then
            ui_paint blue "$UI_ICO_OPEN"
        else
            REPLY=" "
        fi
        status_icon=$REPLY

        ui_clip $label_end "${names[i]}"
        name=$REPLY
        ui_clip $(( room - label_end - 2 )) "${shown[i]}" left
        path_text=$REPLY
        pad=$(( label_end - ${(m)#name} + 1 ))
        fill=$(( width - label_end - 6 - ${(m)#path_text} ))
        (( fill >= 0 )) || fill=0
        ui_paint text "$name"
        label=$REPLY
        ui_paint overlay0 dim "$path_text"

        UI_ROWS+=("$icon "$'\t'"$label"$'\t'"${(l:pad:)sp}$REPLY${(l:fill:)sp}$status_icon"$'\t'"$wt")
    done
}

# ui_preview <path>: the preview pane for a worktree. It starts one line
# down, because fzf draws its scroll position over the first line.
ui_preview() {
    local wt=${1-} name upstream line out
    print
    if [[ ! -d $wt ]]; then
        ui_paint red "$UI_ICO_MISSING folder missing"
        print -r -- "$REPLY"
        ui_paint subtext0 "$(tildify "$wt")"
        print -r -- "$REPLY"
        return 0
    fi

    name=$(git -C "$wt" branch --show-current 2>/dev/null || true)
    [[ -n $name ]] || name=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null || true)
    ui_paint text bold "$name"
    print -r -- "$REPLY"
    ui_paint subtext0 "$(tildify "$wt")"
    print -r -- "$REPLY"

    upstream=$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
    if [[ -n $upstream ]]; then
        local -a counts=($(git -C "$wt" rev-list --left-right --count 'HEAD...@{upstream}' 2>/dev/null || true))
        ui_paint blue "$upstream"
        out=$REPLY
        ui_paint overlay0 dim " → "
        out+=$REPLY
        ui_paint text "${counts[1]:-0} ahead, ${counts[2]:-0} behind"
        print -r -- "$out$REPLY"
    fi

    local -a changes=(${(f)"$(git -C "$wt" status --short 2>/dev/null | head -n 10 || true)"})
    (( ! ${#changes} )) || print
    for line in "${changes[@]}"; do
        if [[ $line == '??'* ]]; then
            ui_paint yellow '??'
            out=$REPLY
        else
            ui_paint green "${line[1]}"
            out=$REPLY
            ui_paint red "${line[2]}"
            out+=$REPLY
        fi
        ui_paint text "${line[4,-1]}"
        print -r -- "$out $REPLY"
    done

    local -a commits=(${(f)"$(git -C "$wt" log --oneline --no-decorate --color=never -8 2>/dev/null || true)"})
    (( ! ${#commits} )) || print
    for line in "${commits[@]}"; do
        ui_paint overlay0 dim "${line%% *}"
        out=$REPLY
        ui_paint text "${line#* }"
        print -r -- "$out $REPLY"
    done
}

# ui_ask <prompt> <default> <hints> [<notice>] [<fzf args>...]: an input
# line of the new-worktree steps. The answer goes in UI_QUERY, and the key
# in UI_KEY when --expect is passed. Returns 130 on Esc.
ui_ask() {
    local prompt=$1 default=$2 hints=$3 notice=${4-} out st=0
    shift $(( $# < 4 ? $# : 4 ))
    ui_header "$hints" "New worktree" "$notice"
    out=$(ui_fzf "$prompt" "$REPLY" --print-query --disabled --query "$default" "$@" </dev/null) || st=$?
    (( st != 130 )) || return 130
    (( st == 0 || st == 1 )) || die "fzf exited with status $st."
    local -a lines=("${(@f)out}")
    UI_QUERY=${lines[1]-} UI_KEY=${lines[2]-}
}

# ui_sources: fill UI_SOURCES with a row per local and origin branch, once
# each, default first. A row is icon<TAB>branch<TAB>plain branch.
typeset -ga UI_SOURCES
ui_sources() {
    local default ref icon
    default=$(detect_default_branch)
    local -a names=()
    for ref in ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin)"}; do
        ref=${ref#origin/}
        [[ $ref == (origin|HEAD) ]] || names+=("$ref")
    done
    names=("${(@u)names}")
    if (( ${names[(Ie)$default]} )); then
        names=("$default" "${(@)names:#${(b)default}}")
    fi

    UI_SOURCES=()
    for ref in "${names[@]}"; do
        if [[ $ref == $default ]]; then
            ui_paint overlay1 "$UI_ICO_HOME"
        else
            ui_paint overlay1 "$UI_ICO_BRANCH"
        fi
        icon=$REPLY
        ui_paint text "$ref"
        UI_SOURCES+=("$icon "$'\t'"$REPLY"$'\t'"$ref")
    done
}

# ui_new <default>: the new-worktree steps, then cmd_new. Sets UI_BACK when
# Esc discards them. Must not run on the left of || or &&, which would turn
# off err_exit inside cmd_new.
typeset -gi UI_BACK=0
ui_new() {
    local branch=$1 notice="" hints="$UI_ENTER accept · esc discards"
    UI_BACK=1
    while true; do
        ui_ask 'Branch: ' "$branch" "$hints" "$notice" || return 0
        branch=$UI_QUERY notice=""
        [[ -n $branch ]] || continue
        git check-ref-format --branch "$branch" >/dev/null 2>&1 && break
        ui_paint red "$UI_ICO_ALERT '$branch' is not a valid branch name"
        notice=$REPLY
    done

    local -a args=(-b "$branch")
    if ! git show-ref --verify --quiet "refs/heads/$branch" &&
        ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        ui_sources
        local out st=0
        ui_header "$hints" "New worktree"
        out=$(print -rl -- "${UI_SOURCES[@]}" |
            ui_fzf 'Source: ' "$REPLY" --delimiter $'\t' --with-nth 1..2 --nth 2 --tabstop 1 \
                --bind 'enter:accept-non-empty') || st=$?
        (( st != 130 )) || return 0
        (( st == 0 )) || die "fzf exited with status $st."
        args+=(-s "${out##*$'\t'}")
    fi

    if [[ $OPEN_IN == herdr ]]; then
        ui_ask 'Label: ' "" "$UI_ENTER accept · ^o don't open in Herdr · esc discards" "" \
            --expect ctrl-o || return 0
        if [[ $UI_KEY != ctrl-o ]]; then
            args+=(--herdr)
            [[ -z $UI_QUERY ]] || args+=(-n "$UI_QUERY")
        fi
    fi

    UI_BACK=0
    cmd_new "${args[@]}"
}

cmd_ui() {
    wants_help "$@" && { usage; exit 0; }
    take_open_flags "" "$@"
    [[ $OPEN_IN != tmux ]] || usage_error "" "--tmux isn't supported yet."
    if (( ${#ARGS} )); then
        [[ ${ARGS[1]} == -* ]] && usage_error "" "Unknown option: ${ARGS[1]}"
        usage_error "" "Unexpected argument: ${ARGS[1]}"
    fi
    exec 3>&1 1>&2
    git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a Git repository."
    command -v fzf >/dev/null 2>&1 || die "The picker needs fzf: brew install fzf"

    local -a words=(${(z)"$(fzf --version 2>/dev/null || true)"})
    local ver=${words[1]-} major minor
    major=${ver%%.*} minor=${${ver#*.}%%.*}
    [[ $major == <-> && $minor == <-> ]] && (( major > 0 || minor >= 36 )) ||
        die "The picker needs fzf 0.36 or newer; found ${ver:-an unknown version}." "brew upgrade fzf"

    ui_theme
    export WKT_THEME=$UI_THEME
    herdr_paths
    local header out st
    ui_header "$UI_ENTER open · ^n new · esc quit"
    header=$REPLY

    while true; do
        ui_rows
        local -a args=(--delimiter $'\t' --with-nth 1..3 --nth 2 --tabstop 1 --expect ctrl-n --print-query
            --preview "${(q)SELF} __preview {4}" --preview-window 'right,40%,border-left')
        (( UI_AT <= 1 )) || args+=(--bind "load:pos($UI_AT)")

        st=0
        out=$({ (( ! ${#UI_ROWS} )) || print -rl -- "${UI_ROWS[@]}"; } |
            ui_fzf '> ' "$header" "${args[@]}") || st=$?
        (( st != 130 )) || exit 130
        (( st == 0 || st == 1 )) || die "fzf exited with status $st."
        ui_parse "$out"

        if [[ $UI_KEY == ctrl-n || -z $UI_SEL ]]; then
            ui_new "$UI_QUERY"
            (( ! UI_BACK )) || continue
            (( WKT_HERDR_OPENED )) || print -r -- "$WKT_PATH" >&3
            return 0
        fi
        local wt=${UI_SEL##*$'\t'}
        [[ $OPEN_IN == herdr ]] && herdr_open "$(common_git_dir)" "$wt" "" --focus || print -r -- "$wt" >&3
        return 0
    done
}

case "${1-}" in
    setup ) shift; cmd_setup "$@" ;;
    adopt ) shift; cmd_adopt "$@" ;;
    new ) shift; cmd_new "$@" ;;
    rename ) shift; cmd_rename "$@" ;;
    rm ) shift; cmd_rm "$@" ;;
    -h | --help | help ) usage ;;
    -V | --version ) print -r -- "wkt $VERSION" ;;
    __preview ) shift; ui_theme; ui_preview "$@" ;;
    "" | --herdr | --tmux | --no-herdr )
        if [[ -t 0 && -t 2 || -n ${WKT_ASSUME_TTY-} ]]; then
            cmd_ui "$@"
        else
            usage >&2
            exit 2
        fi ;;
    -* ) usage_error "" "Unknown option: $1" ;;
    * ) usage_error "" "Unknown command: $1" ;;
esac
